{
  "ConnectionStrings": {
    "WeraDatabase": "Host=localhost;Port=55432;Username=postgres;Database=wera_g3_net"
  },
  "Tokens": {
    "Issuer": "wera-pro-hd-api",
    "Audience": "wera-pro-hd-clients",
    "AccessTokenMinutes": 15,
    "RefreshTokenHours": 12
  },
  "RateLimiting": {
    "AuthPermitLimit": 5,
    "AuthWindowSeconds": 60,
    "ApiTokenLimit": 200,
    "ApiTokensPerSecond": 20,
    "ApiQueueLimit": 50
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
