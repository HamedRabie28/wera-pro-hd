<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    WeraPro.Api — ASP.NET Core 10: المصدر الوحيد للحقيقة لمحطات متعددة (ADR-002).
    مصادقة/تفويض لكل endpoint · تحقق · Health Checks · OpenAPI · معالجة أخطاء
    موحدة · Rate Limiting · Correlation IDs (ARCHITECTURE_BRIEF §1).
  -->
  <PropertyGroup>
    <RootNamespace>WeraPro.Api</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WeraPro.Domain\WeraPro.Domain.csproj" />
    <ProjectReference Include="..\WeraPro.Contracts\WeraPro.Contracts.csproj" />
    <ProjectReference Include="..\WeraPro.Application\WeraPro.Application.csproj" />
    <ProjectReference Include="..\WeraPro.Infrastructure\WeraPro.Infrastructure.csproj" />
    <!-- G5: عامل استيراد الوسائط الخلفي -->
    <ProjectReference Include="..\WeraPro.BackgroundServices\WeraPro.BackgroundServices.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Enrichers.Environment" />
  </ItemGroup>

  <!-- مشغلات الإنتاج: تولّد مفتاح توقيع محلياً عند أول تشغيل (لا يوزَّع مفتاح مع الحزمة) -->
  <ItemGroup>
    <None Include="run-api.cmd" CopyToOutputDirectory="PreserveNewest" />
    <None Include="run-api.sh" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
