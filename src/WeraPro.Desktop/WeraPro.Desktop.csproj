<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WeraPro.Desktop — WinUI 3 / XAML / MVVM (ADR-001) · G3: الإقلاع وتسجيل الدخول
    والتنقل العلوي وفتح POS المستقلة، متصلاً بالـAPI عبر IHttpClientFactory.
    ممنوع منعًا باتًا (ADR-002): أي مرجع Npgsql/EF/اتصال مباشر بقاعدة البيانات —
    مفروض بفحص معماري آلي في tests/WeraPro.Api.Tests (ArchitectureTests).
    البناء: Windows فقط (B-05) — راجع README.md داخل المشروع.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>WeraPro.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <!-- نقطة دخول مخصصة: Program.cs (Bootstrap.Initialize قبل WinUI — إصلاح
         «التشغيل في الخلفية/الشاشة البيضاء»). هذا الثابت يمنع مولّد XAML من
         إنشاء Program.Main مكرر في App.g.i.cs (CS0101/CS0111). -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- 2026-11-07: تثبيت Unpackaged عبر Inno Setup — WindowsPackageType=None إلزامي
         حتى يعمل الملف التنفيذي مباشرة (دون MSIX). غيابه كان سبب «التشغيل في الخلفية
         دون نافذة»: بناء packaged ثم تشغيل exe مباشرة يفشل صامتًا. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- أيقونة التطبيق (exe/المهمة/النافذة) — حزمة الأيقونات الاحترافية Assets/ -->
    <ApplicationIcon>Assets\appicon.ico</ApplicationIcon>
    <!-- عقود API من مشروع العقود المشترك — لا نسخ DTO يدوية -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WeraPro.Contracts\WeraPro.Contracts.csproj" />
    <!-- لاحظ: لا ProjectReference إلى Infrastructure/Domain — العميل يرى العقود فقط -->
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
