           تغطي العربية واللاتينية بأوزان حقيقية 400/600/700؛ البدائل نظامية موثوقة إن تعذّر التحميل) ═══════════ -->
    <FontFamily x:Key="WeraFontBody">ms-appx:///Assets/Fonts/IBMPlexSansArabic-Regular.ttf#IBM Plex Sans Arabic, Dubai, Tahoma, Segoe UI</FontFamily>
    <FontFamily x:Key="WeraFontDisplay">ms-appx:///Assets/Fonts/IBMPlexSansArabic-SemiBold.ttf#IBM Plex Sans Arabic SemiBold, Dubai, Tahoma, Segoe UI</FontFamily>
    <FontFamily x:Key="WeraFontMono">Cascadia Mono, Consolas</FontFamily>
    <!-- الخط الافتراضي لعناصر التحكم غير المنسّقة صراحةً (TextBox/ComboBox/…):
         يُدمج هذا القاموس بعد XamlControlsResources في App.xaml فيطغى على قيمة النظام -->
    <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/IBMPlexSansArabic-Regular.ttf#IBM Plex Sans Arabic, Dubai, Tahoma, Segoe UI</FontFamily>

    <x:Double x:Key="WeraTextPageTitleSize">26</x:Double>
