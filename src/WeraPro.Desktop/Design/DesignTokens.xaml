    <!-- خط شعري فاتح على حافة البطاقة الزجاجية -->
    <Color x:Key="WeraGlassHairlineColor">#3DFFFFFF</Color>
    <SolidColorBrush x:Key="WeraGlassHairlineBrush" Color="{StaticResource WeraGlassHairlineColor}" />
    <!-- لون التراجع حين يتعذر الضباب (وضع توفير الطاقة): كحلي شبه معتم -->
    <Color x:Key="WeraGlassFallbackColor">#F2102238</Color>
    <!-- طبقات تعتيم الصورة الخلفية للقراءة النصية فوقها -->
    <Color x:Key="WeraScrimTopColor">#4D102238</Color>
    <Color x:Key="WeraScrimMidColor">#66102238</Color>
    <Color x:Key="WeraScrimBottomColor">#E6102238</Color>

