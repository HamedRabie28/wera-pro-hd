<?xml version="1.0" encoding="utf-8"?>
<!-- Wera.Styles.xaml — أنماط مشتقة من Tokens فقط (§7.2: لا قيم عشوائية) -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ترويسة الجدول -->
    <Style x:Key="GridHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource WeraFontBody}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource WeraBrandBlueSecondaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="GridHeaderEndStyle" TargetType="TextBlock" BasedOn="{StaticResource GridHeaderStyle}">
        <!-- الأرقام والعملات: محاذاة موحدة (§7.2.1) -->
        <Setter Property="TextAlignment" Value="Left"/>
    </Style>

    <!-- خلية مالية: أرقام tabular -->
    <Style x:Key="MoneyCellStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource WeraBrandNavyBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Left"/>
    </Style>

    <!-- زر إجراء جدول: 34px (§7.1) -->
    <Style x:Key="RowActionStyle" TargetType="Button">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="{StaticResource WeraSurfaceBaseBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource WeraBorderDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- Pagination -->
    <Style x:Key="PageNumStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="Background" Value="{StaticResource WeraSurfaceBaseBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource WeraBorderDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="PageCurrentStyle" TargetType="Button" BasedOn="{StaticResource PageNumStyle}">
        <Setter Property="Background" Value="{StaticResource WeraBrandNavyBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- زر POS لمسي: 50px (§7.1) -->
    <Style x:Key="PosTouchButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="50"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontFamily" Value="{StaticResource WeraFontDisplay}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- القيمة المالية الرئيسية في POS: 32/700 (§7.1) -->
    <Style x:Key="PosMoneyStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource WeraFontDisplay}"/>
        <Setter Property="FontSize" Value="32"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource WeraBrandNavyBrush}"/>
    </Style>
    <!-- تبويبات نوافذ POS -->
    <Style x:Key="TabActiveStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource WeraActionPrimarySoftBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource WeraActionPrimaryInkBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource WeraFontDisplay}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="16,11"/>
        <Setter Property="BorderThickness" Value="0,0,0,2.5"/>
        <Setter Property="BorderBrush" Value="{StaticResource WeraActionPrimaryBrush}"/>
    </Style>
    <Style x:Key="TabInactiveStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource WeraTextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="16,11"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <!-- لوحة أرقام لمسية: هدف ≥48px داخل الدفع (POS_VISUAL_SPEC §4) -->
    <Style x:Key="KeypadStyle" TargetType="Button">
        <Setter Property="Width" Value="64"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="{StaticResource WeraSurfaceBaseBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource WeraBorderDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- ═══ زر الإجراء الأساسي (Primary CTA): قالب مخصص لأن WinUI يستبدل الخلفية
         بمورد النظام الرمادي عند التحويم — هذا القالب يثبّت الهوية (Hover/Pressed من Tokens) ═══ -->
    <Style x:Key="WeraPrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource WeraActionPrimaryBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource WeraTextOnDarkBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource WeraFontDisplay}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="Padding" Value="24,10"/>
        <Setter Property="CornerRadius" Value="{StaticResource WeraCornerRadiusControlLarge}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource WeraActionPrimaryHoverBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource WeraActionPrimaryPressedBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource WeraSurfaceSubtleBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Content" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource WeraTextMutedBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter x:Name="Content" Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Foreground="{TemplateBinding Foreground}"
                                              FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                                              FontWeight="{TemplateBinding FontWeight}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ مفتاح فترة الرئيسية (HOME-01): أزرار راديو متلاصقة بمظهر مقطعي (Segmented) —
         المحدد بخلفية العلامة، والباقي شفاف. لا قوائم منسدلة للفترات الشائعة (§7.5 ق3) ═══ -->
    <Style x:Key="WeraPeriodToggleStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource WeraTextSecondaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource WeraFontBody}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource WeraSurfaceRowAltBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource WeraSurfaceSubtleBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource WeraActionPrimaryBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource WeraTextOnDarkBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Unchecked"/>
                                <VisualState x:Name="Indeterminate"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Root" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
