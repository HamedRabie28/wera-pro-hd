<!-- Views/InventoryHubPage.xaml — WERA PRO HD Desktop (G6)
     لوحة المخزون (PAGE-18): الأرصدة من الدفتر والمحجوز والمتاح (المتاح =
     الرصيد − المحجوز §12.1) + النواقص وإعادة الطلب (PAGE-22) + الدفعات
     والصلاحية (PAGE-23) + التقييم WAC (D-02) — كل البيانات من الخادم. -->
<Page
    x:Class="WeraPro.Desktop.Views.InventoryHubPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" FlowDirection="RTL"
    xmlns:vm="using:WeraPro.Desktop.ViewModels">

    <Grid RowSpacing="10" Padding="18,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- شريط البحث والفلاتر -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
            <TextBox x:Name="SearchBox" Width="260" PlaceholderText="ابحث بكود الصيغة أو المنتج…"
                     KeyDown="SearchBox_KeyDown"/>
            <ComboBox x:Name="WarehouseFilter" Width="200" PlaceholderText="كل المخازن"
                      DisplayMemberPath="NameAr" SelectionChanged="WarehouseFilter_SelectionChanged"/>
            <CheckBox x:Name="BelowReorderBox" Content="النواقص فقط" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
            <Button Content="بحث" Style="{StaticResource AccentButtonStyle}" Click="Search_Click"/>
            <ProgressRing x:Name="LoadingRing" Width="22" Height="22" Visibility="Collapsed"/>
        </StackPanel>

        <!-- حالات الصدق -->
        <TextBlock Grid.Row="1" x:Name="ErrorText" Foreground="{StaticResource WeraStatusDangerBrush}"
                   FontSize="13" Visibility="Collapsed" TextWrapping="Wrap"/>

        <!-- تبويبات اللوحة: الأرصدة / النواقص / الدفعات / التقييم -->
        <Pivot Grid.Row="2" x:Name="HubTabs">
            <PivotItem Header="الأرصدة (PAGE-18)">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8" Grid.Row="0" Margin="0,4,0,8">
                        <TextBlock Text="المتاح = الرصيد − المحجوز (§12.1)" FontSize="12"
                                   Foreground="{StaticResource WeraTextSecondaryBrush}"/>
                    </StackPanel>
                    <ListView Grid.Row="1" x:Name="BalancesList" ItemsSource="{x:Bind Vm.Balances}" SelectionMode="Single"
                              DoubleTapped="BalancesList_DoubleTapped">
                        <ListView.HeaderTemplate>
                            <DataTemplate>
                                <Grid Padding="10,6" Background="{StaticResource WeraSurfaceSubtleBrush}" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/><ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/><ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="110"/><ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="90"/><ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="120"/><ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="الصيغة" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Grid.Column="1" Text="المنتج" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Grid.Column="2" Text="المخزن" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Grid.Column="3" Text="النوع" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Grid.Column="4" Text="الرصيد (أساس)" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Grid.Column="5" Text="محجوز" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Grid.Column="6" Text="متاح" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Grid.Column="7" Text="إعادة الطلب" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Grid.Column="8" Text="التقييم (WAC)" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Grid.Column="9" Text="الحالة" FontWeight="SemiBold" FontSize="12"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.HeaderTemplate>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:BalanceRow">
                                <Grid Padding="10,7" ColumnSpacing="10" Background="{StaticResource WeraSurfaceBaseBrush}"
                                      BorderBrush="{StaticResource WeraBorderRowBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/><ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/><ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="110"/><ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="90"/><ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="120"/><ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind SkuCode}" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Product}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{x:Bind Warehouse}" FontSize="12"/>
                                    <TextBlock Grid.Column="3" Text="{x:Bind SaleModeAr}" FontSize="12"/>
                                    <TextBlock Grid.Column="4" Text="{x:Bind BaseQtyAr}" FontSize="12"/>
                                    <TextBlock Grid.Column="5" Text="{x:Bind ReservedAr}" FontSize="12"/>
                                    <TextBlock Grid.Column="6" Text="{x:Bind AvailableAr}" FontSize="12"/>
                                    <TextBlock Grid.Column="7" Text="{x:Bind ReorderAr}" FontSize="12"/>
                                    <TextBlock Grid.Column="8" Text="{x:Bind ValuationAr}" FontSize="12"/>
                                    <TextBlock Grid.Column="9" Text="{x:Bind BelowReorder}" FontSize="12"
                                               Foreground="{StaticResource WeraStatusDangerBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,8">
                        <Button Content="السابق" Click="PrevPage_Click"/>
                        <TextBlock x:Name="PageText" VerticalAlignment="Center" FontSize="12"/>
                        <Button Content="التالي" Click="NextPage_Click"/>
                        <TextBlock x:Name="TotalText" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{StaticResource WeraTextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </PivotItem>

            <PivotItem Header="النواقص وإعادة الطلب (PAGE-22)">
                <ListView ItemsSource="{x:Bind Vm.Reorder}">
                    <ListView.HeaderTemplate>
                        <DataTemplate>
                            <Grid Padding="10,6" Background="{StaticResource WeraSurfaceSubtleBrush}" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/><ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="110"/><ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="الصيغة" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Grid.Column="1" Text="المنتج" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Grid.Column="2" Text="المخزن" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Grid.Column="3" Text="المتاح" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Grid.Column="4" Text="مستوى الطلب" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Grid.Column="5" Text="الكمية الموصى بها" FontWeight="SemiBold" FontSize="12"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.HeaderTemplate>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ReorderRow">
                            <Grid Padding="10,7" ColumnSpacing="10" BorderBrush="{StaticResource WeraBorderRowBrush}" BorderThickness="0,0,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/><ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="110"/><ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind SkuCode}" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind Product}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2" Text="{x:Bind Warehouse}" FontSize="12"/>
                                <TextBlock Grid.Column="3" Text="{x:Bind AvailableAr}" FontSize="12"/>
                                <TextBlock Grid.Column="4" Text="{x:Bind LevelAr}" FontSize="12"/>
                                <TextBlock Grid.Column="5" Text="{x:Bind SuggestedAr}" FontSize="12" FontWeight="SemiBold"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </PivotItem>

            <PivotItem Header="الدفعات والصلاحية (PAGE-23)">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="دفعات قريبة الانتهاء (30 يوماً) — رصيد كل دفعة من الدفتر" FontSize="12"
                                   Foreground="{StaticResource WeraTextSecondaryBrush}" VerticalAlignment="Center"/>
                        <Button x:Name="DamageButton" Content="تسوية هالك/تلف (باعتماد مشرف)…" Click="Damage_Click"/>
                    </StackPanel>
                    <ListView Grid.Row="1" ItemsSource="{x:Bind Vm.Lots}">
                        <ListView.HeaderTemplate>
                            <DataTemplate>
                                <Grid Padding="10,6" Background="{StaticResource WeraSurfaceSubtleBrush}" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/><ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="120"/><ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="120"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="الصيغة" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Grid.Column="1" Text="الدفعة" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Grid.Column="2" Text="الصلاحية" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Grid.Column="3" Text="الحالة" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Grid.Column="4" Text="الرصيد" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Grid.Column="5" Text="أصل الاستلام" FontWeight="SemiBold" FontSize="12"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.HeaderTemplate>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:LotRow">
                                <Grid Padding="10,7" ColumnSpacing="10" BorderBrush="{StaticResource WeraBorderRowBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/><ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="120"/><ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="120"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind SkuCode}" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind LotCode}" FontSize="12"/>
                                    <TextBlock Grid.Column="2" Text="{x:Bind ExpiryAr}" FontSize="12"/>
                                    <TextBlock Grid.Column="3" Text="{x:Bind ExpiryStateAr}" FontSize="12"
                                               Foreground="{StaticResource WeraStatusDangerBrush}"/>
                                    <TextBlock Grid.Column="4" Text="{x:Bind OnHandAr}" FontSize="12"/>
                                    <TextBlock Grid.Column="5" Text="{x:Bind ReceiptAr}" FontSize="12"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>

            <PivotItem Header="تقييم المخزون (WAC — D-02)">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="14" FontWeight="SemiBold">
                        <Run Text="إجمالي قيمة المخزون (متوسط مرجح متحرك محسوم V012): "/>
                        <Run x:Name="ValuationTotalText" Text="—"/>
                    </TextBlock>
                    <ListView Grid.Row="1" ItemsSource="{x:Bind Vm.ValuationLines}">
                        <ListView.HeaderTemplate>
                            <DataTemplate>
                                <Grid Padding="10,6" Background="{StaticResource WeraSurfaceSubtleBrush}" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/><ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="120"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="الصيغة" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Grid.Column="1" Text="المخزن" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Grid.Column="2" Text="الكمية" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Grid.Column="3" Text="متوسط التكلفة" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Grid.Column="4" Text="القيمة" FontWeight="SemiBold" FontSize="12"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.HeaderTemplate>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ValuationLineDto">
                                <Grid Padding="10,7" ColumnSpacing="10" BorderBrush="{StaticResource WeraBorderRowBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/><ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="120"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind SkuCode}" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind WarehouseCode}" FontSize="12"/>
                                    <TextBlock Grid.Column="2" Text="{x:Bind BaseQty}" FontSize="12"/>
                                    <TextBlock Grid.Column="3" Text="{x:Bind AvgUnitCost}" FontSize="12"/>
                                    <TextBlock Grid.Column="4" Text="{x:Bind Valuation}" FontSize="12"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
