<!-- Views/PartiesPage.xaml — WERA PRO HD Desktop (G6)
     الأطراف: الموردون (PAGE-31) والعملاء (PAGE-29) — التعطيل لا الحذف،
     وكشف الحساب بنافذة مستقلة بفلترة الفترة (PAGE-32/30). -->
<Page FontFamily="{StaticResource WeraFontBody}"
    x:Class="WeraPro.Desktop.Views.PartiesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d" FlowDirection="RightToLeft"
    xmlns:vm="using:WeraPro.Desktop.ViewModels">

    <Grid RowSpacing="10" Padding="18,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Pivot Grid.Row="0" x:Name="PartyTabs">
            <PivotItem Header="الموردون (PAGE-31)">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBox x:Name="SupplierSearchBox" Width="240" PlaceholderText="ابحث بالكود أو الاسم…"
                             KeyDown="SupplierSearch_KeyDown"/>
                    <Button Content="بحث" Click="SupplierSearch_Click"/>
                    <Button x:Name="NewSupplierButton" Content="مورد جديد…" Click="NewSupplier_Click"/>
                </StackPanel>
            </PivotItem>
            <PivotItem Header="العملاء (PAGE-29)">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBox x:Name="CustomerSearchBox" Width="240" PlaceholderText="ابحث بالكود أو الاسم…"
                             KeyDown="CustomerSearch_KeyDown"/>
                    <Button Content="بحث" Click="CustomerSearch_Click"/>
                    <Button x:Name="NewCustomerButton" Content="عميل جديد…" Click="NewCustomer_Click"/>
                </StackPanel>
            </PivotItem>
        </Pivot>

        <TextBlock Grid.Row="1" x:Name="ErrorText" FontSize="13" Foreground="{StaticResource WeraStatusDangerBrush}" Visibility="Collapsed" TextWrapping="Wrap"/>

        <Pivot Grid.Row="2">
            <PivotItem Header="قائمة الموردين">
                <ListView x:Name="SuppliersList" ItemsSource="{x:Bind Vm.Suppliers}" SelectionMode="Single"
                          DoubleTapped="SuppliersList_DoubleTapped">
                    <ListView.HeaderTemplate>
                        <DataTemplate>
                            <Grid Padding="10,6" Background="{StaticResource WeraSurfaceSubtleBrush}" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="130"/><ColumnDefinition Width="100"/><ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="الكود" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Grid.Column="1" Text="الاسم" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Grid.Column="2" Text="الهاتف" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Grid.Column="3" Text="شروط السداد" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Grid.Column="4" Text="الحالة" FontWeight="SemiBold" FontSize="12"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.HeaderTemplate>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:SupplierRow">
                            <Grid Padding="10,7" ColumnSpacing="10" BorderBrush="{StaticResource WeraBorderRowBrush}" BorderThickness="0,0,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="130"/><ColumnDefinition Width="100"/><ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Code}" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind NameAr}" FontSize="12"/>
                                <TextBlock Grid.Column="2" Text="{x:Bind PhoneAr}" FontSize="12"/>
                                <TextBlock Grid.Column="3" Text="{x:Bind TermsAr}" FontSize="12"/>
                                <TextBlock Grid.Column="4" Text="{x:Bind StatusAr}" FontSize="12"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </PivotItem>
            <PivotItem Header="قائمة العملاء">
                <ListView x:Name="CustomersList" ItemsSource="{x:Bind Vm.Customers}" SelectionMode="Single"
                          DoubleTapped="CustomersList_DoubleTapped">
                    <ListView.HeaderTemplate>
                        <DataTemplate>
                            <Grid Padding="10,6" Background="{StaticResource WeraSurfaceSubtleBrush}" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="130"/><ColumnDefinition Width="140"/><ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="الكود" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Grid.Column="1" Text="الاسم" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Grid.Column="2" Text="الهاتف" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Grid.Column="3" Text="الائتمان" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Grid.Column="4" Text="الحالة" FontWeight="SemiBold" FontSize="12"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.HeaderTemplate>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:CustomerRow">
                            <Grid Padding="10,7" ColumnSpacing="10" BorderBrush="{StaticResource WeraBorderRowBrush}" BorderThickness="0,0,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="130"/><ColumnDefinition Width="140"/><ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Code}" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind NameAr}" FontSize="12"/>
                                <TextBlock Grid.Column="2" Text="{x:Bind PhoneAr}" FontSize="12"/>
                                <TextBlock Grid.Column="3" Text="{x:Bind CreditAr}" FontSize="12"/>
                                <TextBlock Grid.Column="4" Text="{x:Bind StatusAr}" FontSize="12"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
