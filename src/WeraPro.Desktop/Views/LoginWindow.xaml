<?xml version="1.0" encoding="utf-8"?>
<!--
  Views/LoginWindow.xaml — بوابة الدخول (G3): عنوان الخادم محدد من appsettings،
  هوية حقيقية من API، اختيار فرع/محطة، وحالة اتصال صادقة (§10.6).
  كل القيم البصرية من DesignTokens (G2 المعتمدة).
-->
<Window
    x:Class="WeraPro.Desktop.Views.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid FlowDirection="RightToLeft" Background="{StaticResource WeraSurfaceBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- بطاقة الدخول -->
        <Border Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{StaticResource WeraSurfaceBaseBrush}"
                BorderBrush="{StaticResource WeraBorderDefaultBrush}" BorderThickness="1"
                CornerRadius="16" Padding="40,32" Width="420">
            <StackPanel Spacing="14">
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource WeraActionPrimaryBrush}">
                        <TextBlock Text="W" Foreground="White" FontWeight="Bold" FontSize="20"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="WERA PRO HD" FontFamily="{StaticResource WeraFontDisplay}"
                               FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource WeraBrandNavyBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="تسجيل الدخول" FontSize="14" Foreground="{StaticResource WeraTextSecondaryBrush}"
                           HorizontalAlignment="Center"/>

                <StackPanel Spacing="4">
                    <TextBlock Text="اسم المستخدم" FontSize="12.5"/>
                    <TextBox x:Name="UsernameField" Height="40" FontSize="14" PlaceholderText="مثال: owner"/>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="كلمة المرور" FontSize="12.5"/>
                    <PasswordBox x:Name="PasswordField" Height="40" FontSize="14" KeyDown="Password_KeyDown"/>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="الفرع" FontSize="12.5"/>
                    <ComboBox x:Name="BranchField" Height="40" HorizontalAlignment="Stretch"
                              DisplayMemberPath="NameAr" SelectionChanged="BranchField_SelectionChanged"/>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="المحطة" FontSize="12.5"/>
                    <ComboBox x:Name="StationField" Height="40" HorizontalAlignment="Stretch"
                              DisplayMemberPath="NameAr" IsEnabled="False"/>
                </StackPanel>

                <Button x:Name="LoginBtn" Content="دخول" Height="44" FontSize="15"
                        Background="{StaticResource WeraActionPrimaryBrush}" Foreground="White"
                        BorderThickness="0" CornerRadius="10" HorizontalAlignment="Stretch"
                        Click="Login_Click"/>
            </StackPanel>
        </Border>

        <!-- شريط الحالة الصادق -->
        <Border Grid.Row="1" Background="{StaticResource WeraBrandNavyDeepBrush}" Padding="16,8">
            <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource WeraActionPrimaryInkBrush}" x:Name="ServerDot"/>
                    <TextBlock x:Name="ServerStatusText" Text="لم يُتحقق من الخادم بعد" FontSize="12"
                               Foreground="{StaticResource WeraShellTextSecondaryBrush}"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" Text="أدخل بيانات الدخول" FontSize="12"
                           Foreground="{StaticResource WeraShellTextMutedBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
