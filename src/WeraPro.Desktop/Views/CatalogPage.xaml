<?xml version="1.0" encoding="utf-8"?>
<!--
  Views/CatalogPage.xaml — PAGE-09 كتالوج المنتجات بجدول متقدم (LF-B) · G4
  بيانات حقيقية من الخادم عبر ترقيم صفحات (server-side) دائماً · حالات صدق:
  تحميل/خطأ/فارغ · فلترة صيغة البيع والحالة · بحث نصي محدود (حرفان فأكثر).
  عمود الصورة المصغرة يُفعّل مع مكتبة الوسائط في G5 (لا صورة وهمية).
-->
<UserControl FontFamily="{StaticResource WeraFontBody}"
    x:Class="WeraPro.Desktop.Views.CatalogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:vm="using:WeraPro.Desktop.ViewModels">

    <Grid FlowDirection="RightToLeft" Background="{StaticResource WeraSurfaceBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Padding="28,20,28,12" Spacing="4">
            <TextBlock Text="كتالوج المنتجات" FontFamily="{StaticResource WeraFontDisplay}"
                       FontSize="26" FontWeight="Bold" Foreground="{StaticResource WeraBrandNavyBrush}"/>
            <TextBlock Text="بحث وفلاتر متقدمة — ترقيم صفحات من الخادم دائماً (لا مسح غير محدود)"
                       FontSize="13" Foreground="{StaticResource WeraTextSecondaryBrush}"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource WeraSurfaceBaseBrush}"
                BorderBrush="{StaticResource WeraBorderDefaultBrush}" BorderThickness="1"
                CornerRadius="14" Margin="28,0,28,24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Toolbar: بحث + فلاتر + منتج جديد -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Padding="14,11">
                    <TextBlock Text="المنتجات" FontFamily="{StaticResource WeraFontDisplay}" FontSize="14.5"
                               FontWeight="SemiBold" Foreground="{StaticResource WeraBrandNavyBrush}" VerticalAlignment="Center"/>
                    <TextBox x:Name="SearchBox" PlaceholderText="ابحث بالاسم أو الكود… (حرفان فأكثر)" Width="260" Height="38"
                             KeyDown="SearchBox_KeyDown"/>
                    <Button Content="بحث" Background="{StaticResource WeraActionPrimaryBrush}" Foreground="White" BorderThickness="0" CornerRadius="10" Click="Search_Click"/>
                    <ComboBox x:Name="SaleModeFilter" Width="150" Height="38" SelectedIndex="0" SelectionChanged="Filter_Changed">
                        <ComboBoxItem Content="صيغة البيع: الكل"/>
                        <ComboBoxItem Content="عددي"/>
                        <ComboBoxItem Content="وزني"/>
                        <ComboBoxItem Content="عبوة"/>
                        <ComboBoxItem Content="سيريال"/>
                    </ComboBox>
                    <ComboBox x:Name="StatusFilter" Width="130" Height="38" SelectedIndex="0" SelectionChanged="Filter_Changed">
                        <ComboBoxItem Content="الحالة: الكل"/>
                        <ComboBoxItem Content="نشط"/>
                        <ComboBoxItem Content="معطل"/>
                        <ComboBoxItem Content="موقوف"/>
                    </ComboBox>
                    <Button Content="⟳ تحديث" Background="{StaticResource WeraSurfaceBaseBrush}" BorderBrush="{StaticResource WeraBorderDefaultBrush}" BorderThickness="1" CornerRadius="10" Click="Refresh_Click"/>
                    <Button x:Name="NewProductBtn" Content="＋ منتج جديد" Background="{StaticResource WeraActionPrimaryBrush}" Foreground="White" BorderThickness="0" CornerRadius="10" Click="NewProduct_Click"/>
                </StackPanel>

                <!-- الملخص الحقيقي من الخادم -->
                <TextBlock Grid.Row="1" x:Name="SummaryText" Text="—" FontSize="12"
                           Foreground="{StaticResource WeraTextSecondaryBrush}" Padding="14,2,14,8"/>

                <!-- الجدول: ترويسة ثابتة · حدود أفقية فقط -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{StaticResource WeraSurfaceSubtleBrush}"
                            BorderBrush="{StaticResource WeraBorderDefaultBrush}" BorderThickness="0,0,0,1">
                        <Grid Padding="14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/><ColumnDefinition Width="2.1*"/><ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="1.1*"/><ColumnDefinition Width="0.8*"/><ColumnDefinition Width="0.8*"/>
                                <ColumnDefinition Width="1.1*"/><ColumnDefinition Width="0.9*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="المنتج" Style="{StaticResource GridHeaderStyle}"/>
                            <TextBlock Grid.Column="2" Text="SKU / الباركود" Style="{StaticResource GridHeaderStyle}"/>
                            <TextBlock Grid.Column="3" Text="الفئة" Style="{StaticResource GridHeaderStyle}"/>
                            <TextBlock Grid.Column="4" Text="صيغة البيع" Style="{StaticResource GridHeaderStyle}"/>
                            <TextBlock Grid.Column="5" Text="الوحدة" Style="{StaticResource GridHeaderStyle}"/>
                            <TextBlock Grid.Column="6" Text="السعر (شامل الضريبة)" Style="{StaticResource GridHeaderEndStyle}"/>
                            <TextBlock Grid.Column="7" Text="الحالة" Style="{StaticResource GridHeaderStyle}"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1">
                        <ItemsControl x:Name="RowsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CatalogRow">
                                    <Grid Height="49" Padding="14,0" BorderBrush="{StaticResource WeraBorderRowBrush}"
                                          BorderThickness="0,0,0,1" Background="{StaticResource WeraSurfaceBaseBrush}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44"/><ColumnDefinition Width="2.1*"/><ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="1.1*"/><ColumnDefinition Width="0.8*"/><ColumnDefinition Width="0.8*"/>
                                            <ColumnDefinition Width="1.1*"/><ColumnDefinition Width="0.9*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                                                Background="{StaticResource WeraSurfaceSubtleBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind ProductName}" FontWeight="SemiBold" FontSize="13"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="{x:Bind SkuCode}" FontFamily="{StaticResource WeraFontMono}" FontSize="11.5"
                                                       Foreground="{StaticResource WeraTextSecondaryBrush}"/>
                                            <TextBlock Text="{x:Bind Barcode}" FontFamily="{StaticResource WeraFontMono}" FontSize="11"
                                                       Foreground="{StaticResource WeraTextMutedBrush}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" Text="{x:Bind Category}" FontSize="12.5" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{x:Bind SaleMode}" FontSize="12.5" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="5" Text="{x:Bind Unit}" FontSize="12.5" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="6" Text="{x:Bind Price}" Style="{StaticResource MoneyCellStyle}"/>
                                        <TextBlock Grid.Column="7" Text="{x:Bind Status}" FontSize="12" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- حالات صدق: تحميل · خطأ · فارغ -->
                <ProgressRing Grid.Row="2" x:Name="LoadingRing" Width="36" Height="36"
                              HorizontalAlignment="Center" VerticalAlignment="Center" IsActive="False"/>
                <StackPanel Grid.Row="2" x:Name="ErrorPanel" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="460">
                    <TextBlock x:Name="ErrorText" TextWrapping="Wrap" FontSize="13.5"
                               Foreground="{StaticResource WeraStatusDangerBrush}" HorizontalAlignment="Center"/>
                    <Button Content="إعادة المحاولة" Background="{StaticResource WeraActionPrimaryBrush}" Foreground="White" BorderThickness="0" CornerRadius="10" Click="Refresh_Click" HorizontalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Row="2" x:Name="EmptyText" Text="لا نتائج تطابق البحث — جرّب كلمة أطول أو الفلاتر" Visibility="Collapsed"
                           FontSize="13.5" Foreground="{StaticResource WeraTextMutedBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <!-- Pagination -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="12" Padding="14,10"
                            BorderBrush="{StaticResource WeraBorderDefaultBrush}" BorderThickness="0,1,0,0">
                    <Button x:Name="PrevBtn" Content="‹ السابق" Background="{StaticResource WeraSurfaceBaseBrush}" BorderBrush="{StaticResource WeraBorderDefaultBrush}" BorderThickness="1" CornerRadius="10" Click="PrevPage_Click"/>
                    <Button x:Name="NextBtn" Content="التالي ›" Background="{StaticResource WeraSurfaceBaseBrush}" BorderBrush="{StaticResource WeraBorderDefaultBrush}" BorderThickness="1" CornerRadius="10" Click="NextPage_Click"/>
                    <TextBlock x:Name="PageText" Text="—" FontSize="12" Foreground="{StaticResource WeraTextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
