<!-- Views/UsersPage.xaml — WERA PRO HD Desktop (G-ADMIN)
     المستخدمون والأدوار والصلاحيات (PAGE-47): إنشاء/تعديل/تعطيل (لا حذف) +
     إعادة كلمة المرور + إسناد الأدوار بنطاق فرع أو الكل — hash فقط (§18).
     الأدوار المرجعية السبعة صلبة (V009) — تُعرض بصلاحياتها الذرية. -->
<Page
    x:Class="WeraPro.Desktop.Views.UsersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d" FlowDirection="RightToLeft"
    xmlns:vm="using:WeraPro.Desktop.ViewModels">

    <Grid RowSpacing="10" Padding="18,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Pivot Grid.Row="0" x:Name="UsersTabs" SelectionChanged="Tabs_SelectionChanged">
            <PivotItem Header="المستخدمون (PAGE-47)">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBox x:Name="SearchBox" Width="240" PlaceholderText="ابحث باسم الدخول أو الاسم…"
                             KeyDown="Search_KeyDown"/>
                    <Button Content="بحث" Click="Search_Click"/>
                    <Button x:Name="NewUserButton" Content="مستخدم جديد…" Click="NewUser_Click"
                            Style="{StaticResource WeraPrimaryButtonStyle}"/>
                </StackPanel>
            </PivotItem>
            <PivotItem Header="الأدوار والصلاحيات">
                <TextBlock Text="الأدوار المرجعية السبعة صلبة بقرار V009 — الإسناد والفك فقط، لا تحرير الأدوار أو صلاحياتها من الواجهة"
                           FontSize="12" Foreground="{StaticResource WeraTextSecondaryBrush}"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
            </PivotItem>
        </Pivot>

        <TextBlock Grid.Row="1" x:Name="ErrorText" FontSize="13" Foreground="{StaticResource WeraStatusDangerBrush}"
                   Visibility="Collapsed" TextWrapping="Wrap"/>
        <TextBlock Grid.Row="1" x:Name="StatusText" FontSize="12" Foreground="{StaticResource WeraTextMutedBrush}"
                   Text="{x:Bind Vm.StatusAr, Mode=OneWay}" TextWrapping="Wrap"/>

        <!-- تبويب المستخدمين -->
        <ListView Grid.Row="2" x:Name="UsersList" ItemsSource="{x:Bind Vm.Users}" SelectionMode="Single"
                  DoubleTapped="UsersList_DoubleTapped">
            <ListView.HeaderTemplate>
                <DataTemplate>
                    <Grid Padding="10,6" Background="{StaticResource WeraSurfaceSubtleBrush}" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/><ColumnDefinition Width="220"/><ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="250"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="#" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Grid.Column="1" Text="اسم الدخول" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Grid.Column="2" Text="الاسم" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Grid.Column="3" Text="البريد" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Grid.Column="4" Text="الأدوار" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Grid.Column="5" Text="الحالة" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Grid.Column="6" Text="إجراءات" FontWeight="SemiBold" FontSize="12"/>
                    </Grid>
                </DataTemplate>
            </ListView.HeaderTemplate>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:UserRow">
                    <Grid Padding="10,7" ColumnSpacing="10" BorderBrush="{StaticResource WeraBorderRowBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/><ColumnDefinition Width="220"/><ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="250"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind UserId}" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{x:Bind Username}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{x:Bind DisplayNameAr}" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="{x:Bind EmailAr}" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="{x:Bind RolesAr}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock Grid.Column="5" Text="{x:Bind StatusAr}" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{x:Bind StatusBrush, Mode=OneWay}"/>
                        <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button Content="تعديل" FontSize="11" Padding="10,4" Click="EditUser_Click" Tag="{x:Bind}"/>
                            <Button Content="كلمة المرور" FontSize="11" Padding="10,4" Click="ResetPassword_Click" Tag="{x:Bind}"/>
                            <Button Content="الأدوار" FontSize="11" Padding="10,4" Click="Roles_Click" Tag="{x:Bind}"/>
                            <Button FontSize="11" Padding="10,4" Click="ToggleActive_Click" Tag="{x:Bind}"
                                    Content="{x:Bind ToggleLabel, Mode=OneWay}"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- تبويب الأدوار والصلاحيات (يظهر بدلاً من القائمة عند اختياره) -->
        <ScrollViewer Grid.Row="2" x:Name="RolesView" Visibility="Collapsed" Padding="0,4">
            <ItemsControl ItemsSource="{x:Bind Vm.Roles}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RoleRow">
                        <Border Background="{StaticResource WeraSurfaceBaseBrush}" BorderBrush="{StaticResource WeraBorderDefaultBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,10">
                            <StackPanel Spacing="8">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Border Width="34" Height="34" CornerRadius="9"
                                                Background="{StaticResource WeraActionPrimarySoftBrush}">
                                            <TextBlock Text="{x:Bind Code}" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{StaticResource WeraActionPrimaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind NameAr}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource WeraBrandNavyBrush}"/>
                                            <TextBlock Text="{x:Bind DescriptionAr}" FontSize="11.5"
                                                       Foreground="{StaticResource WeraTextMutedBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Border Background="{StaticResource WeraActionPrimarySoftBrush}" CornerRadius="999" Padding="10,3">
                                            <TextBlock Text="{x:Bind PermissionsCountAr}" FontSize="11"
                                                       Foreground="{StaticResource WeraActionPrimaryBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{x:Bind DomainsAr}" FontSize="11.5" TextWrapping="Wrap"
                                           Foreground="{StaticResource WeraTextSecondaryBrush}"/>
                                <TextBlock Text="الصلاحيات الذرية (تُفرض خادمياً على كل عملية — §18):"
                                           FontSize="11" Foreground="{StaticResource WeraTextMutedBrush}"/>
                                <ItemsControl ItemsSource="{x:Bind PermissionRows}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Vertical" Spacing="2"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PermissionRow">
                                            <Grid ColumnSpacing="8" Padding="0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="170"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Code}" FontSize="11" FontFamily="{StaticResource WeraFontMono}"
                                                           Foreground="{StaticResource WeraTextSecondaryBrush}"/>
                                                <Border Grid.Column="1" Background="{StaticResource WeraSurfaceSubtleBrush}" CornerRadius="6" Padding="6,1" HorizontalAlignment="Left">
                                                    <TextBlock Text="{x:Bind DomainAr}" FontSize="10.5" Foreground="{StaticResource WeraTextMutedBrush}"/>
                                                </Border>
                                                <TextBlock Grid.Column="2" Text="{x:Bind DescriptionAr}" FontSize="11" Foreground="{StaticResource WeraTextSecondaryBrush}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
