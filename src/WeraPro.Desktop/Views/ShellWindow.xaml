<?xml version="1.0" encoding="utf-8"?>
<!--
  Views/ShellWindow.xaml — Shell الإداري (G3): شريط علوي فقط · لا Sidebar (§7.3).
  هوية مستخدم حقيقية من الجلسة + حالة اتصال حقيقية (لا «متصل» زوراً §10.6) +
  مجموعات التنقل — غير المبني منها معط بسبب معلن (قاعدة الصدق §0.1 ق10).
-->
<Window
    x:Class="WeraPro.Desktop.Views.ShellWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Grid FlowDirection="RightToLeft" Background="{StaticResource WeraSurfaceBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>   <!-- TopNav: WeraTopNavHeight -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ الشريط العلوي (brand.navy) ═══ -->
        <Grid Grid.Row="0" Background="{StaticResource WeraBrandNavyBrush}" Padding="18,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- الشعار + فتح POS المستقلة -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                <Button x:Name="OpenPosBtn" Click="OpenPos_Click" Background="#00000000" BorderThickness="0" Padding="0">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource WeraActionPrimaryBrush}">
                            <TextBlock Text="W" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="WERA PRO HD" Foreground="{StaticResource WeraShellTextBrush}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- مجموعات القوائم — المبني فقط يفتح؛ غير المبني معط بسبب معلن -->
            <muxc:NavigationView Grid.Column="1" x:Name="NavTop" PaneDisplayMode="Top"
                                 IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False"
                                 OpenPaneLength="0" Margin="12,0"
                                 SelectionChanged="NavTop_SelectionChanged">
                <muxc:NavigationView.MenuItems>
                    <muxc:NavigationViewItem Content="التشغيل" Tag="home" IsSelected="True"/>
                    <muxc:NavigationViewItem Content="المبيعات (G7)" Tag="sales" IsEnabled="False" ToolTipService.ToolTip="يبني في بوابة G7 — غير متاح بعد"/>
                    <muxc:NavigationViewItem Content="الكتالوج (G4)" Tag="catalog" IsEnabled="False" ToolTipService.ToolTip="يبني في بوابة G4 — غير متاح بعد"/>
                    <muxc:NavigationViewItem Content="المخزون (G6)" Tag="inventory" IsEnabled="False" ToolTipService.ToolTip="يبني في بوابة G6 — غير متاح بعد"/>
                    <muxc:NavigationViewItem Content="المشتريات (G6)" Tag="purchasing" IsEnabled="False" ToolTipService.ToolTip="يبني في بوابة G6 — غير متاح بعد"/>
                </muxc:NavigationView.MenuItems>
            </muxc:NavigationView>

            <!-- حالة اتصال حقيقية -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="14,0">
                <Ellipse Width="8" Height="8" Fill="{StaticResource WeraActionPrimaryInkBrush}" x:Name="ConnDot"/>
                <TextBlock x:Name="ConnText" Text="جارٍ التحقق…" FontSize="12" Foreground="{StaticResource WeraShellTextSecondaryBrush}"/>
            </StackPanel>

            <!-- المستخدم/الدور/الخروج -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                        Padding="12,0" BorderBrush="{StaticResource WeraShellBorderBrush}" BorderThickness="1,0,0,0">
                <Border Width="30" Height="30" CornerRadius="999" Background="{StaticResource WeraAccentGoldBrush}">
                    <TextBlock x:Name="UserInitials" Text="؟" Foreground="White" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel>
                    <TextBlock x:Name="UserNameText" Text="—" FontSize="12" Foreground="{StaticResource WeraShellTextBrush}"/>
                    <TextBlock x:Name="UserRoleText" Text="—" FontSize="10" Foreground="{StaticResource WeraShellTextMutedBrush}"/>
                </StackPanel>
                <Button x:Name="LogoutBtn" Click="Logout_Click" Background="#00000000" BorderThickness="0"
                        ToolTipService.ToolTip="إنهاء الجلسة وإغلاق التطبيق">
                    <FontIcon Glyph="&#xE7E8;" FontSize="14" Foreground="{StaticResource WeraShellTextSecondaryBrush}"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ═══ المحتوى: صفحة التشغيل التأسيسية ═══ -->
        <ScrollViewer Grid.Row="1" Padding="24,18">
            <StackPanel Spacing="14" MaxWidth="900" HorizontalAlignment="Stretch">
                <TextBlock Text="التشغيل" FontFamily="{StaticResource WeraFontDisplay}" FontSize="20"
                           FontWeight="SemiBold" Foreground="{StaticResource WeraBrandNavyBrush}"/>
                <TextBlock x:Name="ScopeText" Text="—" FontSize="12.5" Foreground="{StaticResource WeraTextSecondaryBrush}"/>

                <!-- بطاقة الحالة التأسيسية — بيانات حقيقية من الخادم -->
                <Border Background="{StaticResource WeraSurfaceBaseBrush}" BorderBrush="{StaticResource WeraBorderDefaultBrush}"
                        BorderThickness="1" CornerRadius="14" Padding="18,14">
                    <StackPanel Spacing="8">
                        <TextBlock Text="أساس G3 قائم ويعمل" FontSize="14.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource WeraBrandNavyBrush}"/>
                        <TextBlock Text="الخادم: API موثق + مصادقة JWT + صلاحيات خادمية + ترحيلات SQL خطية · العميل: متصل عبر IHttpClientFactory ولا يملك أي وصول مباشر لقاعدة البيانات."
                                   FontSize="12.5" Foreground="{StaticResource WeraTextSecondaryBrush}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="WeighingText" Text="إعدادات الوزن (D-07): تُجلب من الخادم…"
                                   FontSize="12" Foreground="{StaticResource WeraTextMutedBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- الوحدات القادمة — أسباب معلنة لا صفحات وهمية -->
                <Border Background="{StaticResource WeraSurfaceSubtleBrush}" CornerRadius="14" Padding="18,14">
                    <StackPanel Spacing="6">
                        <TextBlock Text="الوحدات القادمة (بعد اعتماد كل بوابة)" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource WeraTextSecondaryBrush}"/>
                        <TextBlock FontSize="12" Foreground="{StaticResource WeraTextMutedBrush}" TextWrapping="Wrap"
                                   Text="G4 الكتالوج والمحرر · G5 مكتبة الصور · G6 المخزون والمشتريات · G7 POS الكاملة (الوزن/الدفع/المرتجع) · G8 الورديات والخزينة · G9 المحاسبة والتقارير · G10 الأجهزة · G11 DPI · G13 الحمل · G14 التغليف"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
