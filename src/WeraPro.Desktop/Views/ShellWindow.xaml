<?xml version="1.0" encoding="utf-8"?>
<!--
  Views/ShellWindow.xaml — Shell الإداري (G3): شريط علوي فقط · لا Sidebar (§7.3).
  هوية مستخدم حقيقية من الجلسة + حالة اتصال حقيقية (لا «متصل» زوراً §10.6) +
  مجموعات التنقل — غير المبني منها معط بسبب معلن (قاعدة الصدق §0.1 ق10).
-->
<Window
    x:Class="WeraPro.Desktop.Views.ShellWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:views="using:WeraPro.Desktop.Views">
    <UserControl FontFamily="{StaticResource WeraFontBody}">


        <Grid FlowDirection="RightToLeft" Background="{StaticResource WeraSurfaceBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>   <!-- TopNav: WeraTopNavHeight -->
                <RowDefinition Height="Auto"/><!-- تنقل ثانٍ لمجموعة المخزون -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ═══ الشريط العلوي (brand.navy) ═══ -->
            <Grid Grid.Row="0" Background="{StaticResource WeraBrandNavyBrush}" Padding="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- الشعار + فتح POS المستقلة -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                    <Button x:Name="OpenPosBtn" Click="OpenPos_Click" Background="#00000000" BorderThickness="0" Padding="0">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource WeraActionPrimaryBrush}">
                                <TextBlock Text="W" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="WERA PRO HD" Foreground="{StaticResource WeraShellTextBrush}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- مجموعات القوائم — المبني فقط يفتح؛ غير المبني معط بسبب معلن -->
                <muxc:NavigationView Grid.Column="1" x:Name="NavTop" PaneDisplayMode="Top"
                                     IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False"
                                     OpenPaneLength="0" Margin="12,0"
                                     SelectionChanged="NavTop_SelectionChanged">
                    <muxc:NavigationView.MenuItems>
                        <muxc:NavigationViewItem Content="الرئيسية" Tag="home" IsSelected="True" ToolTipService.ToolTip="HOME-01: مركز التشغيل التنفيذي — مؤشرات وتنبيهات وحدات تشغيل من الخادم"/>
                        <muxc:NavigationViewItem Content="نقطة البيع (POS)" Tag="pos" ToolTipService.ToolTip="G7: نافذة بيع مستقلة — سلالم ومساحيق ومرتجعات وسلات معلّقة وورديات"/>
                        <muxc:NavigationViewItem Content="الكتالوج" Tag="catalog" ToolTipService.ToolTip="G4: المنتجات وصيغ البيع والعبوات والباركود — بحث Exact Match"/>
                        <muxc:NavigationViewItem Content="مكتبة الصور" Tag="media" ToolTipService.ToolTip="G5: رفع/ربط/فك ربط/رئيسية/مكررات — الحذف محمي بمراجعة"/>
                        <muxc:NavigationViewItem Content="المخزون" Tag="inventory" ToolTipService.ToolTip="G6: لوحة الأرصدة والنواقص والدفعات والتقييم + الجرد والتحويلات والمخازن"/>
                        <muxc:NavigationViewItem Content="المشتريات" Tag="purchasing" ToolTipService.ToolTip="G6: السلة والاستلامات وفواتير الموردين والسداد والمرتجعات"/>
                        <muxc:NavigationViewItem Content="الأطراف" Tag="parties" ToolTipService.ToolTip="G6: الموردون والعملاء وكشوف الحساب — التعطيل لا الحذف"/>
                        <muxc:NavigationViewItem Content="المالية (G8)" Tag="finance" ToolTipService.ToolTip="G8: الخزائن والسندات والمصروفات ورأس المال والورديات وإقفالها (PAGE-33..38)"/>
                        <muxc:NavigationViewItem Content="سجل المبيعات" Tag="sales" ToolTipService.ToolTip="G7: فواتير البيع (PAGE-03) + السلال المعلقة (PAGE-06) + المدفوعات والمطابقة (PAGE-08)"/>
                        <muxc:NavigationViewItem Content="المرتجعات" Tag="returns" ToolTipService.ToolTip="G7: مرتجع مرتبط بالفاتورة الأصل باعتماد مشرف ورد بوسيلة الدفع الأصلية (PAGE-05 · D-04)"/>
                        <muxc:NavigationViewItem Content="المستخدمون والصلاحيات" Tag="users" ToolTipService.ToolTip="G-ADMIN: المستخدمون والأدوار السبعة وصلاحياتهم الذرية — التعطيل لا الحذف (PAGE-47)"/>
                        <muxc:NavigationViewItem Content="الإعدادات" Tag="settings" ToolTipService.ToolTip="G-ADMIN: إعدادات النشاط وقرارات D-01..D-18 بحقيقة حسمها (PAGE-52)"/>
                        <muxc:NavigationViewItem Content="النسخ والصيانة" Tag="maintenance" ToolTipService.ToolTip="G-ADMIN: نسخ احتياطية موثقة واستعادة وتنظيف وحذف كامل بمنطقة خطر (PAGE-51)"/>
                    </muxc:NavigationView.MenuItems>
                </muxc:NavigationView>

                <!-- حالة اتصال حقيقية -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="14,0">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource WeraActionPrimaryInkBrush}" x:Name="ConnDot"/>
                    <TextBlock x:Name="ConnText" Text="جارٍ التحقق…" FontSize="12" Foreground="{StaticResource WeraShellTextSecondaryBrush}"/>
                </StackPanel>

                <!-- المستخدم/الدور/الخروج -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                            Padding="12,0" BorderBrush="{StaticResource WeraShellBorderBrush}" BorderThickness="1,0,0,0">
                    <Border Width="30" Height="30" CornerRadius="999" Background="{StaticResource WeraAccentGoldBrush}">
                        <TextBlock x:Name="UserInitials" Text="؟" Foreground="White" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock x:Name="UserNameText" Text="—" FontSize="12" Foreground="{StaticResource WeraShellTextBrush}"/>
                        <TextBlock x:Name="UserRoleText" Text="—" FontSize="10" Foreground="{StaticResource WeraShellTextMutedBrush}"/>
                    </StackPanel>
                    <Button x:Name="LogoutBtn" Click="Logout_Click" Background="#00000000" BorderThickness="0"
                            ToolTipService.ToolTip="إنهاء الجلسة وإغلاق التطبيق">
                        <FontIcon Glyph="&#xE7E8;" FontSize="14" Foreground="{StaticResource WeraShellTextSecondaryBrush}"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ═══ تنقل ثانٍ لمجموعة المخزون (G6 · إصلاح 2026-11-11ب) ═══
                 كانت صفحات المخزون الأربع تُعرض معاً في نفس الخلية فتتراكب فوق بعضها
                 (الأرصدة تحت الجرد تحت التحويلات)، وصفحة المخازن (PAGE-28) بلا أي
                 مدخل — الآن تبويب واحد ظاهر في كل لحظة. -->
            <Grid Grid.Row="1" x:Name="InventorySubNav" Visibility="Collapsed"
                  Background="{StaticResource WeraSurfaceSubtleBrush}"
                  BorderBrush="{StaticResource WeraShellBorderBrush}" BorderThickness="0,1,0,1" Padding="18,5">
                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                    <TextBlock Text="المخزون ▸" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{StaticResource WeraTextMutedBrush}"/>
                    <Button x:Name="SubBalances" Tag="inventory" Click="SubNav_Click"
                            Background="#00000000" BorderThickness="0" Padding="10,5">
                        <TextBlock Text="الأرصدة (PAGE-18)" FontSize="12"/>
                    </Button>
                    <Button x:Name="SubStocktake" Tag="stocktake" Click="SubNav_Click"
                            Background="#00000000" BorderThickness="0" Padding="10,5">
                        <TextBlock Text="الجرد والتسويات (PAGE-20)" FontSize="12"/>
                    </Button>
                    <Button x:Name="SubTransfers" Tag="transfers" Click="SubNav_Click"
                            Background="#00000000" BorderThickness="0" Padding="10,5">
                        <TextBlock Text="التحويلات (PAGE-21)" FontSize="12"/>
                    </Button>
                    <Button x:Name="SubWarehouses" Tag="warehouses" Click="SubNav_Click"
                            Background="#00000000" BorderThickness="0" Padding="10,5">
                        <TextBlock Text="المخازن والفروع (PAGE-28)" FontSize="12"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ═══ المحتوى: الرئيسية التنفيذية أو صفحات الوحدات (G4..G-ADMIN) ═══ -->
            <Grid Grid.Row="2">
                <!-- ═══ الرئيسية التنفيذية HOME-01 (G9) — كل مؤشر من الخادم عبر Analytics API ═══ -->
                <views:HomePage x:Name="HomeContent"/>

                <!-- صفحة الكتالوج (G4) — تُعرض عند اختيار «الكتالوج» -->
                <views:CatalogPage x:Name="CatalogContent" Visibility="Collapsed"/>

                <!-- مكتبة الوسائط (G5 · PAGE-16) — تُعرض عند اختيار «مكتبة الصور» -->
                <views:MediaLibraryPage x:Name="MediaContent" Visibility="Collapsed"/>

                <!-- المخزون (G6 · PAGE-18..23) — تبويبات: الأرصدة/النواقص/الدفعات/التقييم -->
                <views:InventoryHubPage x:Name="InventoryContent" Visibility="Collapsed"/>

                <!-- الجرد والتسويات (G6 · PAGE-20) -->
                <views:StocktakePage x:Name="StocktakeContent" Visibility="Collapsed"/>

                <!-- التحويلات بين المخازن (G6 · PAGE-21) -->
                <views:TransfersPage x:Name="TransfersContent" Visibility="Collapsed"/>

                <!-- المشتريات (G6 · PAGE-24..27) — تبويبات: السلة/الاستلامات/الفواتير والسداد/المرتجعات -->
                <views:PurchasingHubPage x:Name="PurchasingContent" Visibility="Collapsed"/>

                <!-- الأطراف (G6 · PAGE-29..32) — الموردون والعملاء وكشوف الحساب -->
                <views:PartiesPage x:Name="PartiesContent" Visibility="Collapsed"/>

                <!-- إدارة المخازن (G6 · PAGE-28) -->
                <views:WarehousesPage x:Name="WarehousesContent" Visibility="Collapsed"/>

                <!-- المالية (G8 · PAGE-33..38): الخزائن والسندات والمصروفات ورأس المال والورديات -->
                <views:FinancePage x:Name="FinanceContent" Visibility="Collapsed"/>

                <!-- سجل المبيعات (G7 · PAGE-03/06/08) -->
                <views:SalesLogPage x:Name="SalesContent" Visibility="Collapsed"/>

                <!-- المرتجعات والاستردادات (G7 · PAGE-05) -->
                <views:ReturnsPage x:Name="ReturnsContent" Visibility="Collapsed"/>

                <!-- المستخدمون والصلاحيات (G-ADMIN · PAGE-47) -->
                <views:UsersPage x:Name="UsersContent" Visibility="Collapsed"/>

                <!-- الإعدادات العامة (G-ADMIN · PAGE-52) -->
                <views:SettingsPage x:Name="SettingsContent" Visibility="Collapsed"/>

                <!-- النسخ الاحتياطي والصيانة (G-ADMIN · PAGE-51 + منطقة الخطر) -->
                <views:MaintenancePage x:Name="MaintenanceContent" Visibility="Collapsed"/>

            </Grid>
        </Grid>

    </UserControl>
</Window>
