<!-- Views/MaintenancePage.xaml — WERA PRO HD Desktop (G-ADMIN)
     النسخ الاحتياطي والاستعادة والصيانة (PAGE-51): نسخ موثقة بسلسلة إسناد
     وبصمة SHA-256 لا يعلن نجاحها إلا بعد تحقق قابلية القراءة (§19 D-09) +
     تنظيف النظام بحد احتفاظ + منطقة الخطر: الحذف الكامل بتحذيرات مزدوجة
     وعبارة تأكيد نصية «حذف نهائي». -->
<Page
    x:Class="WeraPro.Desktop.Views.MaintenancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d" FlowDirection="RightToLeft"
    xmlns:vm="using:WeraPro.Desktop.ViewModels">

    <Grid RowSpacing="10" Padding="18,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- شريط الإحصاءات الحقيقية — قبل أي قرار حذف -->
        <Border Grid.Row="0" Background="{StaticResource WeraSurfaceBaseBrush}" BorderBrush="{StaticResource WeraBorderDefaultBrush}"
                BorderThickness="1" CornerRadius="12" Padding="16,10">
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="النسخ الاحتياطي والصيانة (PAGE-51)" FontSize="17" FontWeight="SemiBold"
                               Foreground="{StaticResource WeraBrandNavyBrush}" VerticalAlignment="Center"
                               FontFamily="{StaticResource WeraFontDisplay}"/>
                    <TextBlock x:Name="DbNameText" Text="—" FontSize="11.5" VerticalAlignment="Center"
                               Foreground="{StaticResource WeraTextMutedBrush}"/>
                </StackPanel>
                <TextBlock x:Name="StatsText" Text="جارٍ جلب إحصاءات النظام…" FontSize="11.5" TextWrapping="Wrap"
                           Foreground="{StaticResource WeraTextSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <Pivot Grid.Row="1" x:Name="MaintTabs" SelectionChanged="Tabs_SelectionChanged">
            <PivotItem Header="النسخ الاحتياطية">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button x:Name="RunBackupButton" Content="تشغيل نسخة كاملة الآن…" Click="RunBackup_Click"
                            Style="{StaticResource WeraPrimaryButtonStyle}"/>
                    <Button Content="تحديث السجل" Click="RefreshBackups_Click"/>
                    <TextBlock Text="النجاح لا يعلن إلا بعد تحقق قابلية القراءة — وانسخ الملف لوسائط خارجية (§19 D-09)"
                               FontSize="11" Foreground="{StaticResource WeraTextMutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </PivotItem>
            <PivotItem Header="تنظيف النظام">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <NumberBox x:Name="RetentionDays" Header="حد الاحتفاظ (يوماً)" Value="180" Minimum="7" Maximum="3650" SpinButtonPlacementMode="Compact" Width="170"/>
                    <Button x:Name="CleanupButton" Content="تنظيف الآن…" Click="Cleanup_Click" VerticalAlignment="Bottom"/>
                    <TextBlock Text="يحذف أحداث التدقيق والجلسات والوسائط اليتيمة ومهام الطباعة الأقدم من الحد — مع توثيق الأثر"
                               FontSize="11" Foreground="{StaticResource WeraTextMutedBrush}" VerticalAlignment="Bottom" TextWrapping="Wrap"/>
                </StackPanel>
            </PivotItem>
            <PivotItem Header="منطقة الخطر — الحذف الكامل">
                <TextBlock Text="⚠ حذف كل بيانات التشغيل نهائياً — يفتح فقط لمن يملك صلاحية ops.system.wipe"
                           FontSize="12" Foreground="{StaticResource WeraStatusDangerBrush}" VerticalAlignment="Center"/>
            </PivotItem>
        </Pivot>

        <TextBlock Grid.Row="2" x:Name="ErrorText" FontSize="13" Foreground="{StaticResource WeraStatusDangerBrush}"
                   Visibility="Collapsed" TextWrapping="Wrap"/>
        <TextBlock Grid.Row="2" x:Name="StatusText" FontSize="12" Foreground="{StaticResource WeraTextMutedBrush}"
                   Text="{x:Bind Vm.StatusAr, Mode=OneWay}" TextWrapping="Wrap"/>

        <!-- ═══ تبويب النسخ الاحتياطية ═══ -->
        <ListView Grid.Row="3" x:Name="BackupsList" ItemsSource="{x:Bind Vm.Backups}" SelectionMode="Single">
            <ListView.HeaderTemplate>
                <DataTemplate>
                    <Grid Padding="10,6" Background="{StaticResource WeraSurfaceSubtleBrush}" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="170"/><ColumnDefinition Width="90"/><ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="110"/><ColumnDefinition Width="100"/><ColumnDefinition Width="190"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="#" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Grid.Column="1" Text="ملف النسخة" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Grid.Column="2" Text="النوع" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Grid.Column="3" Text="الحالة" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Grid.Column="4" Text="الحجم" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Grid.Column="5" Text="التاريخ" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Grid.Column="6" Text="أنشأها" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Grid.Column="7" Text="البصمة" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Grid.Column="8" Text="إجراءات" FontWeight="SemiBold" FontSize="12"/>
                    </Grid>
                </DataTemplate>
            </ListView.HeaderTemplate>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:BackupRow">
                    <Grid Padding="10,7" ColumnSpacing="10" BorderBrush="{StaticResource WeraBorderRowBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="170"/><ColumnDefinition Width="90"/><ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="110"/><ColumnDefinition Width="100"/><ColumnDefinition Width="190"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind BackupId}" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{x:Bind FileName}" FontSize="11" FontFamily="{StaticResource WeraFontMono}"
                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock Grid.Column="2" Text="{x:Bind KindAr}" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="{x:Bind StatusAr}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{x:Bind StatusBrush, Mode=OneWay}"/>
                        <TextBlock Grid.Column="4" Text="{x:Bind SizeAr}" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="5" Text="{x:Bind WhenAr}" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="6" Text="{x:Bind CreatedBy}" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="7" Text="{x:Bind ChecksumAr}" FontSize="11" FontFamily="{StaticResource WeraFontMono}"
                                   VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="8" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button Content="استعادة…" FontSize="11" Padding="10,4" Click="Restore_Click" Tag="{x:Bind}"/>
                            <Button Content="حذف السجل" FontSize="11" Padding="10,4" Click="DeleteBackup_Click" Tag="{x:Bind}"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- ═══ تبويب تنظيف النظام ═══ -->
        <ScrollViewer Grid.Row="3" x:Name="CleanupView" Visibility="Collapsed" Padding="0,4">
            <StackPanel Spacing="12" MaxWidth="860" HorizontalAlignment="Stretch">
                <Border Background="{StaticResource WeraSurfaceBaseBrush}" BorderBrush="{StaticResource WeraBorderDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="18,14">
                    <StackPanel Spacing="8">
                        <TextBlock Text="ماذا يفعل التنظيف؟ (أثر موثق بالأرقام لكل مجموعة)" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource WeraBrandNavyBrush}"/>
                        <TextBlock FontSize="12.5" TextWrapping="Wrap" Foreground="{StaticResource WeraTextSecondaryBrush}"
                                   Text="1) أحداث التدقيق الأقدم من حد الاحتفاظ تُحذف نهائياً — سجل حساس فلا يبقى إلى الأبد بلا قرار.&#x0a;2) الجلسات المفتوحة المعلقة الأقدم من الحد تُغلق (جلسة شاردة = مستخدم يظهر متصلاً زوراً §10.6).&#x0a;3) الوسائط غير المرتبطة بأي منتج والأقدم من الحد تُحذف (رفع متكرر بلا ربط).&#x0a;4) مهام الطباعة المنتهية (ناجحة/فاشلة/ملغاة) الأقدم من الحد تُحذف."/>
                        <TextBlock FontSize="11.5" TextWrapping="Wrap" Foreground="{StaticResource WeraTextMutedBrush}"
                                   Text="الحد الأدنى 7 أياماً والافتراضي 180 — كل عملية تنظيف تُسجَّل في التدقيق بمن نفذها وكم أثراً حذف."/>
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <NumberBox x:Name="RetentionDays2" Header="حد الاحتفاظ (يوماً)" Value="180" Minimum="7" Maximum="3650" Width="170" SpinButtonPlacementMode="Compact"/>
                    <Button x:Name="CleanupButton2" Content="تنفيذ التنظيف…" Click="Cleanup2_Click" VerticalAlignment="Bottom"
                            Style="{StaticResource WeraPrimaryButtonStyle}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ═══ تبويب منطقة الخطر — الحذف الكامل ═══ -->
        <ScrollViewer Grid.Row="3" x:Name="DangerView" Visibility="Collapsed" Padding="0,4">
            <StackPanel Spacing="12" MaxWidth="900" HorizontalAlignment="Stretch">
                <Border Background="{StaticResource WeraStatusDangerSoftBrush}"
                        BorderBrush="{StaticResource WeraStatusDangerBrush}" BorderThickness="1.5"
                        CornerRadius="14" Padding="20,16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="⚠ منطقة الخطر — حذف البيانات بالكامل وتنظيف النظام" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource WeraStatusDangerBrush}"/>
                        <TextBlock FontSize="12.5" TextWrapping="Wrap" Foreground="{StaticResource WeraTextPrimaryBrush}"
                                   Text="هذا الإجراء يحذف نهائياً كل بيانات التشغيل: المنتجات والصيغ والصور وحركات المخزون والجرد والتحويلات وأوامر الشراء والاستلامات وفواتير الموردين والعملاء وفواتير البيع والمدفوعات والمرتجعات والورديات والسندات والمصروفات وأحداث رأس المال وسجل التدقيق. لا يمكن التراجع إلا باستعادة نسخة احتياطية موثقة."/>
                        <StackPanel Spacing="4">
                            <TextBlock Text="التحذيرات الإلزامية قبل التنفيذ:" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource WeraStatusDangerBrush}"/>
                            <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource WeraTextPrimaryBrush}"
                                       Text="• شغّل نسخة احتياطية كاملة وتحقق من قابليتها للقراءة أولاً — وإلا فقرار الحذف غير مسؤول.&#x0a;• كل مستخدمي النظام سيخسرون عملهم الجاري — أغلِق الورديات المفتوحة وأبلغ الفريق.&#x0a;• يبقى بعد الحذف: المستخدمون والأدوار والصلاحيات والإعدادات والفروع والمحطات والمخازن ودليل الحسابات وإعدادات الطابعات — لتشغيل نظيف لا نظاماً أعمى.&#x0a;• الإجراء مقيد بصلاحية ops.system.wipe (المالك) ويُوثَّق في التدقيق بإحصاءات ما قبل الحذف."/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource WeraSurfaceBaseBrush}" BorderBrush="{StaticResource WeraBorderDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="18,14">
                    <StackPanel Spacing="10">
                        <TextBlock Text="خطوتا التأكيد الإلزاميتان:" FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource WeraBrandNavyBrush}"/>
                        <CheckBox x:Name="BackupFirst" Content="شغّلتُ نسخة احتياطية كاملة بعد آخر تغيير وتم التحقق من قابليتها للقراءة"/>
                        <CheckBox x:Name="UnderstandFinal" Content="أفهم أن الحذف نهائي لا يمكن التراجع عنه إلا باستعادة نسخة، وأن كل بيانات التشغيل ستُمحى"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBox x:Name="WipeConfirmBox" Width="300" Header="اكتب عبارة التأكيد حرفياً: حذف نهائي"
                                     PlaceholderText="حذف نهائي"/>
                            <TextBox x:Name="WipeReasonBox" Width="*" MinWidth="260" Header="سبب الحذف الكامل (يُوثَّق في التدقيق)"/>
                        </StackPanel>
                        <Button x:Name="WipeButton" Content="تنفيذ الحذف الكامل للبيانات" Click="Wipe_Click"
                                Background="{StaticResource WeraStatusDangerBrush}" Foreground="White"
                                FontWeight="SemiBold" MinWidth="240" Padding="16,8"/>
                        <TextBlock x:Name="WipeGateText" Text="" FontSize="11.5" TextWrapping="Wrap"
                                   Foreground="{StaticResource WeraStatusWarningBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
