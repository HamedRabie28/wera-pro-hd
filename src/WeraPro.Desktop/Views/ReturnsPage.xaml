<!-- Views/ReturnsPage.xaml — WERA PRO HD Desktop (G7 · PAGE-05)
     المرتجعات والاستردادات (§9.8 · D-04): مرتجع مرتبط بالفاتورة الأصل ربطاً
     إلزامياً، الرد بوسيلة الدفع الأصلية، اعتماد مشرف قبل الترحيل (V005)، والحد
     لكل سطر = المباع − المردود سابقاً — كل التحقق الخادمي يُعرض بصدق هنا. -->
<Page
    x:Class="WeraPro.Desktop.Views.ReturnsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d" FlowDirection="RightToLeft"
    xmlns:vm="using:WeraPro.Desktop.ViewModels">

    <Grid RowSpacing="10" Padding="18,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
            <TextBlock Text="المرتجعات والاستردادات (PAGE-05)" FontSize="18" FontWeight="SemiBold"
                       Foreground="{StaticResource WeraBrandNavyBrush}" VerticalAlignment="Center"
                       FontFamily="{StaticResource WeraFontDisplay}"/>
            <Border Background="{StaticResource WeraSurfaceSubtleBrush}" CornerRadius="999" Padding="10,3" VerticalAlignment="Center">
                <TextBlock Text="لا مرتجع بلا فاتورة أصل واعتماد مشرف — الرد بوسيلة الدفع الأصلية (D-04)"
                           FontSize="11" Foreground="{StaticResource WeraTextMutedBrush}"/>
            </Border>
        </StackPanel>

        <TextBlock Grid.Row="1" x:Name="ErrorText" FontSize="13" Foreground="{StaticResource WeraStatusDangerBrush}"
                   Visibility="Collapsed" TextWrapping="Wrap"/>
        <TextBlock Grid.Row="1" x:Name="StatusText" FontSize="12" Foreground="{StaticResource WeraTextMutedBrush}"
                   Text="{x:Bind Vm.StatusAr, Mode=OneWay}" TextWrapping="Wrap"/>

        <Grid Grid.Row="2" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <!-- ═══ نموذج المرتجع ═══ -->
            <ScrollViewer>
                <StackPanel Spacing="10">
                    <Border Background="{StaticResource WeraSurfaceBaseBrush}" BorderBrush="{StaticResource WeraBorderDefaultBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="14,10">
                        <StackPanel Spacing="8">
                            <TextBlock Text="1) ابحث عن الفاتورة الأصل" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource WeraBrandNavyBrush}"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox x:Name="InvoiceBox" Width="240" PlaceholderText="معرف الفاتورة الرقمي (InvoiceId)"/>
                                <Button Content="تحميل الفاتورة" Click="LoadInvoice_Click"
                                        Style="{StaticResource WeraPrimaryButtonStyle}"/>
                            </StackPanel>
                            <TextBlock Text="{x:Bind Vm.InvoiceHeaderAr, Mode=OneWay}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource WeraTextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource WeraSurfaceBaseBrush}" BorderBrush="{StaticResource WeraBorderDefaultBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="14,10">
                        <StackPanel Spacing="8">
                            <TextBlock Text="2) حدد الكميات المرتجعة لكل سطر (0 = لا رد من السطر)" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource WeraBrandNavyBrush}"/>
                            <TextBlock Text="الحد لكل سطر = المباع − المردود سابقاً — تجاوزه يرفضه الخادم (REFUND_EXCEEDS_SOLD)"
                                       FontSize="11" Foreground="{StaticResource WeraTextMutedBrush}" TextWrapping="Wrap"/>
                            <ListView x:Name="LinesList" ItemsSource="{x:Bind Vm.Lines}" SelectionMode="None" MaxHeight="300">
                                <ListView.HeaderTemplate>
                                    <DataTemplate>
                                        <Grid Padding="8,5" Background="{StaticResource WeraSurfaceSubtleBrush}" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40"/><ColumnDefinition Width="95"/><ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="130"/><ColumnDefinition Width="80"/><ColumnDefinition Width="90"/><ColumnDefinition Width="140"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="سطر" FontWeight="SemiBold" FontSize="11.5"/>
                                            <TextBlock Grid.Column="1" Text="الصنف" FontWeight="SemiBold" FontSize="11.5"/>
                                            <TextBlock Grid.Column="2" Text="الاسم" FontWeight="SemiBold" FontSize="11.5"/>
                                            <TextBlock Grid.Column="3" Text="المباع" FontWeight="SemiBold" FontSize="11.5"/>
                                            <TextBlock Grid.Column="4" Text="السعر" FontWeight="SemiBold" FontSize="11.5"/>
                                            <TextBlock Grid.Column="5" Text="المتبقي" FontWeight="SemiBold" FontSize="11.5"/>
                                            <TextBlock Grid.Column="6" Text="الكمية المرتجعة" FontWeight="SemiBold" FontSize="11.5"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.HeaderTemplate>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RefundLineRow">
                                        <Grid Padding="8,5" ColumnSpacing="8" BorderBrush="{StaticResource WeraBorderRowBrush}" BorderThickness="0,0,0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40"/><ColumnDefinition Width="95"/><ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="130"/><ColumnDefinition Width="80"/><ColumnDefinition Width="90"/><ColumnDefinition Width="140"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind LineNo}" FontSize="11.5" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{x:Bind SkuCode}" FontSize="11.5" FontFamily="{StaticResource WeraFontMono}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{x:Bind NameAr}" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="3" Text="{x:Bind QtyAr}" FontSize="11.5" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="{x:Bind PriceAr}" FontSize="11.5" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="5" Text="{x:Bind RemainingAr}" FontSize="11.5" VerticalAlignment="Center"
                                                       Foreground="{x:Bind ReturnableBrush}"/>
                                            <NumberBox Grid.Column="6" Value="{x:Bind ReturnQty, Mode=TwoWay}" Minimum="0"
                                                       Maximum="{x:Bind MaxReturnQtyDouble, Mode=OneWay}" SpinButtonPlacementMode="Compact"
                                                       IsEnabled="{x:Bind Returnable}" Width="135" HorizontalAlignment="Left"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource WeraSurfaceBaseBrush}" BorderBrush="{StaticResource WeraBorderDefaultBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="14,10">
                        <StackPanel Spacing="8">
                            <TextBlock Text="3) وسيلة الرد والسبب والاعتماد" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource WeraBrandNavyBrush}"/>
                            <TextBlock Text="D-04: الرد بوسيلة الدفع الأصلية — النقد للنقد والبطاقة للبطاقة؛ رد نقدي لقيمة بطاقة قرار OWNER فقط."
                                       FontSize="11" Foreground="{StaticResource WeraTextMutedBrush}" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <ComboBox x:Name="MethodCombo" Header="وسيلة الرد" Width="220" SelectedIndex="0">
                                    <ComboBoxItem Content="نقد (CASH)" Tag="CASH"/>
                                    <ComboBoxItem Content="بطاقة — عكس على البطاقة (CARD)" Tag="CARD"/>
                                    <ComboBoxItem Content="عكس آجل (CREDIT_REVERSAL)" Tag="CREDIT_REVERSAL"/>
                                </ComboBox>
                                <CheckBox x:Name="RestockBox" Content="إعادة للمخزون (ألغِها إن كان هالكاً)" IsChecked="True" VerticalAlignment="Bottom"/>
                            </StackPanel>
                            <TextBox x:Name="ReasonBox" PlaceholderText="سبب المرتجع (إلزامي — 3 محارف على الأقل، يُوثَّق في الاعتماد والتدقيق)"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="طلب اعتماد…" Click="RequestApproval_Click"/>
                                <Button x:Name="PostButton" Content="ترحيل المرتجع" Click="PostRefund_Click"
                                        Style="{StaticResource WeraPrimaryButtonStyle}"/>
                                <TextBlock x:Name="ApprovalText" Text="" FontSize="11.5" VerticalAlignment="Center"
                                           Foreground="{StaticResource WeraTextSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ═══ اعتمادات المرتجعات المعلقة ═══ -->
            <Border Background="{StaticResource WeraSurfaceSubtleBrush}" BorderBrush="{StaticResource WeraBorderDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="14,10">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="طلبات اعتماد المرتجعات المعلقة (V005)" FontSize="13.5" FontWeight="SemiBold"
                               Foreground="{StaticResource WeraBrandNavyBrush}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ApprovalsHint" Text="—" FontSize="11.5" TextWrapping="Wrap"
                               Foreground="{StaticResource WeraTextMutedBrush}"/>
                    <ListView Grid.Row="2" x:Name="ApprovalsList" ItemsSource="{x:Bind Vm.Approvals}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ApprovalRow">
                                <Border Background="{StaticResource WeraSurfaceBaseBrush}" BorderBrush="{StaticResource WeraBorderDefaultBrush}"
                                        BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,0,0,8">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{x:Bind EntityAr}" FontSize="12.5" FontWeight="SemiBold"/>
                                        <TextBlock FontSize="11.5" Foreground="{StaticResource WeraTextSecondaryBrush}" TextWrapping="Wrap">
                                            <Run Text="{x:Bind RequestedBy}"/><Run Text=" · "/><Run Text="{x:Bind WhenAr}"/>
                                        </TextBlock>
                                        <TextBlock Text="{x:Bind ReasonAr}" FontSize="11.5" TextWrapping="Wrap"
                                                   Foreground="{StaticResource WeraTextMutedBrush}"/>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Button Content="موافقة" FontSize="11" Padding="10,4" Click="Approve_Click" Tag="{x:Bind}"
                                                    Style="{StaticResource WeraPrimaryButtonStyle}"/>
                                            <Button Content="رفض" FontSize="11" Padding="10,4" Click="Reject_Click" Tag="{x:Bind}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
