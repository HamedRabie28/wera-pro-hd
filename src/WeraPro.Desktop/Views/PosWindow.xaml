<?xml version="1.0" encoding="utf-8"?>
<!-- Views/PosWindow.xaml — POS نافذة مستقلة بلا أي قائمة إدارية (§9.0 / LF-P) · G3 قشرة:
     شريط جلسة حقيقي + إعدادات وزن من الخادم (D-07) والسلة DEV موسومة بصدق حتى G7.
     الحد الأدنى 1280×720: لوحة المجاميع 300px عند 1366. -->
<Window
    x:Class="WeraPro.Desktop.Views.PosWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource WeraSurfaceBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>   <!-- شريط الجلسة -->
            <RowDefinition Height="Auto"/> <!-- الالتقاط -->
            <RowDefinition Height="*"/>    <!-- السلة + المجاميع -->
            <RowDefinition Height="40"/>   <!-- F-keys -->
        </Grid.RowDefinitions>

        <!-- شريط الجلسة: بيانات حقيقية من الجلسة الموثقة -->
        <Grid Grid.Row="0" Background="{StaticResource WeraBrandNavyDeepBrush}" Padding="14,0">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" HorizontalAlignment="Right">
                <Border Background="{StaticResource WeraActionPrimaryBrush}" CornerRadius="6" Padding="8,2">
                    <TextBlock Text="POS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource WeraShellTealGlowBrush}"/>
                </Border>
                <TextBlock x:Name="SessionText" Text="—" FontSize="12.5" Foreground="{StaticResource WeraShellTextSecondaryBrush}"/>
                <StackPanel Orientation="Horizontal" Spacing="6" BorderBrush="{StaticResource WeraShellBorderBrush}" BorderThickness="1,0,0,0" Padding="12,0">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource WeraActionPrimaryInkBrush}" x:Name="ConnDot"/>
                    <TextBlock x:Name="ConnText" Text="جارٍ التحقق…" FontSize="12" Foreground="{StaticResource WeraShellTealGlowBrush}"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- منطقة الالتقاط: باركود دائم التركيز (يعمل فعلياً من G7 — G3 قشرة) -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Padding="14,10"
                    Background="{StaticResource WeraSurfaceBaseBrush}"
                    BorderBrush="{StaticResource WeraBorderDefaultBrush}" BorderThickness="0,0,0,1">
            <TextBox x:Name="BarcodeField" PlaceholderText="امسح الباركود أو اكتب للبحث… (تفعيل كامل في G7)"
                     FontFamily="{StaticResource WeraFontMono}" FlowDirection="LeftToRight"
                     Height="48" CornerRadius="10" HorizontalAlignment="Stretch" IsEnabled="False"/>
            <Button Content="⚖️ وزن  F2" Style="{StaticResource PosTouchButtonStyle}" IsEnabled="False"
                    ToolTipService.ToolTip="نافذة الوزن تعمل كاملة في G7 (D-07: 1g/5g/Banker's)"/>
            <Button Content="↩ مرتجع  F12" Style="{StaticResource PosTouchButtonStyle}" IsEnabled="False"
                    ToolTipService.ToolTip="المرتجع يعمل في G7"/>
            <Button Content="⏸ تعليق  F8" Style="{StaticResource PosTouchButtonStyle}" IsEnabled="False"
                    ToolTipService.ToolTip="التعليق والاسترجاع يعملان في G7"/>
        </StackPanel>

        <!-- السلة + المجاميع: DEV DATA موسومة بصدق -->
        <Grid Grid.Row="2" Padding="14,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource WeraSurfaceBaseBrush}"
                    BorderBrush="{StaticResource WeraBorderDefaultBrush}" BorderThickness="1" CornerRadius="14">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" Padding="20">
                    <Border Background="{StaticResource WeraStatusWarningSoftBrush}" CornerRadius="10" Padding="14,8">
                        <TextBlock Text="DEV DATA — سلة عرض فقط · البيع الفعلي في G7" FontSize="13"
                                   Foreground="{StaticResource WeraStatusWarningBrush}" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock Text="نافذة POS المستقلة تعمل (G3): إقلاع واتصال وجلسة حقيقية؛ الأدوات الكاملة (وزن/دفع/مرتجع/خصومات) تبني في G7."
                               FontSize="12.5" Foreground="{StaticResource WeraTextSecondaryBrush}" TextWrapping="Wrap"
                               HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="560"/>
                    <Border Background="{StaticResource WeraSurfaceSubtleBrush}" CornerRadius="10" Padding="12,10" MaxWidth="560">
                        <TextBlock x:Name="WeighingText" Text="إعدادات الوزن (D-07): تُجلب من الخادم…"
                                   FontSize="12" Foreground="{StaticResource WeraTextMutedBrush}" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- لوحة المجاميع: معطلة في G3 — لا أرقام مالية وهمية كأنها حقيقية -->
            <StackPanel Grid.Column="1" Spacing="10">
                <Border Background="{StaticResource WeraSurfaceBaseBrush}" BorderBrush="{StaticResource WeraBorderDefaultBrush}"
                        BorderThickness="1" CornerRadius="14" Padding="16">
                    <StackPanel Spacing="7">
                        <TextBlock Text="المستحق" FontFamily="{StaticResource WeraFontDisplay}" FontSize="14"
                                   FontWeight="SemiBold" Foreground="{StaticResource WeraBrandNavyBrush}"/>
                        <TextBlock Text="—" Style="{StaticResource PosMoneyStyle}"/>
                        <TextBlock Text="تُحسب خادمياً من G7 — لا إجمالي من العميل دون إعادة حساب (§9.0)"
                                   FontSize="11" Foreground="{StaticResource WeraTextMutedBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Button Content="💳 الدفع وترحيل الفاتورة  F4" Style="{StaticResource PosTouchButtonStyle}"
                        Background="{StaticResource WeraSurfaceSubtleBrush}" BorderThickness="0" IsEnabled="False"
                        HorizontalAlignment="Stretch" ToolTipService.ToolTip="الدفع يعمل في G7"/>

                <Border Background="{StaticResource WeraSurfaceSubtleBrush}" CornerRadius="10" Padding="12,10">
                    <TextBlock Text="الإيصال يطبع تلقائياً بعد الترحيل على طابعة المحطة المعتمدة (80/58mm المستقل) من G10 · نسخة الإدارة إلكترونية (D-16)"
                               FontSize="11" Foreground="{StaticResource WeraTextSecondaryBrush}" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </Grid>

        <!-- شريط الوظائف الثابت F1..F12 -->
        <Border Grid.Row="3" Background="{StaticResource WeraBrandNavyBrush}" Padding="16,0">
            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <TextBlock Text="F1 بحث · F2 وزن · F3 عميل · F4 دفع · F8 تعليق · F12 مرتجع (تفعيل G7)"
                           FontSize="12" Foreground="{StaticResource WeraShellTextSecondaryBrush}"/>
                <TextBlock Text="G3 — POS SHELL متصلة بالخادم" FontSize="11.5"
                           Foreground="{StaticResource WeraShellTextMutedBrush}" HorizontalAlignment="Left"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
