<?xml version="1.0" encoding="utf-8"?>
<!--
  Views/MediaImportWindow.xaml — PAGE-17 مركز استيراد الصور الدفعي (LF-F) · G5
  خطوات: إنشاء مهمة ← ترحيل ملفات ← تشغيل بخلفية (عامل الخادم) ← تقدم حقيقي
  (حالة كل ملف من القاعدة) ← إلغاء آمن/استئناف ← تقرير لكل ملف بأسباب مسماة.
  الدفعات الكبيرة (حتى 100,000 صورة) لا تجمد الواجهة: الترحيل على دفعات
  والاستقصاء كل 2s أثناء RUNNING فقط.
-->
<Window
    x:Class="WeraPro.Desktop.Views.MediaImportWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">
    <UserControl FontFamily="{StaticResource WeraFontBody}">


        <Grid FlowDirection="RightToLeft" Background="{StaticResource WeraSurfaceBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- الرأس -->
            <StackPanel Grid.Row="0" Padding="22,16,22,8" Spacing="3">
                <TextBlock Text="مركز استيراد الصور الدفعي" FontFamily="{StaticResource WeraFontDisplay}"
                           FontSize="21" FontWeight="Bold" Foreground="{StaticResource WeraBrandNavyBrush}"/>
                <TextBlock Text="المعالجة عند عامل خادم خلفي — لا تجميد للمحطة؛ الإلغاء آمن والاستئناف يقرأ حالة كل ملف (§6.1)"
                           FontSize="12.5" Foreground="{StaticResource WeraTextSecondaryBrush}"/>
            </StackPanel>

            <!-- لوحة المهمة: إنشاء/إضافة/تشغيل/إلغاء -->
            <Border Grid.Row="1" Background="{StaticResource WeraSurfaceBaseBrush}"
                    BorderBrush="{StaticResource WeraBorderDefaultBrush}" BorderThickness="1"
                    CornerRadius="14" Margin="22,4,22,10" Padding="16,12">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBox x:Name="LabelBox" Width="300" Height="38" PlaceholderText="اسم المهمة (3–120 محرفاً)…"/>
                        <Button x:Name="CreateJobBtn" Content="إنشاء مهمة" Background="{StaticResource WeraActionPrimaryBrush}" Foreground="White" BorderThickness="0" CornerRadius="10" Click="CreateJob_Click"/>
                        <Button x:Name="AddFilesBtn" Content="⇪ إضافة صور…" Background="{StaticResource WeraSurfaceBaseBrush}" BorderBrush="{StaticResource WeraBorderDefaultBrush}" BorderThickness="1" CornerRadius="10" Click="AddFiles_Click"/>
                        <Button x:Name="StartBtn" Content="▶ تشغيل/استئناف" Background="{StaticResource WeraActionPrimaryBrush}" Foreground="White" BorderThickness="0" CornerRadius="10" Click="Start_Click"/>
                        <Button x:Name="CancelBtn" Content="⏸ إلغاء آمن" Background="{StaticResource WeraSurfaceBaseBrush}" BorderBrush="{StaticResource WeraBorderDefaultBrush}" BorderThickness="1" CornerRadius="10" Click="Cancel_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <TextBlock x:Name="JobStateText" Text="لا مهمة" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource WeraBrandNavyBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StagedText" Text="0 ملف مرحّل" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{StaticResource WeraTextSecondaryBrush}"/>
                        <TextBlock x:Name="ScopeText" Text="" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{StaticResource WeraTextMutedBrush}" FontFamily="{StaticResource WeraFontMono}"/>
                    </StackPanel>
                    <TextBlock x:Name="CountsText" Text="—" FontSize="12.5" Foreground="{StaticResource WeraTextSecondaryBrush}"/>
                    <TextBlock x:Name="ErrorsText" Text="" FontSize="11.5" Foreground="{StaticResource WeraTextMutedBrush}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="StatusText" Text="" FontSize="12.5" TextWrapping="Wrap"
                               Foreground="{StaticResource WeraTextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- تقرير الملفات: فلترة الحالة + ترقيم -->
            <Border Grid.Row="2" Background="{StaticResource WeraSurfaceBaseBrush}"
                    BorderBrush="{StaticResource WeraBorderDefaultBrush}" BorderThickness="1"
                    CornerRadius="14" Margin="22,0,22,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Padding="14,10">
                        <TextBlock Text="تقرير الملفات" FontFamily="{StaticResource WeraFontDisplay}" FontSize="14.5"
                                   FontWeight="SemiBold" Foreground="{StaticResource WeraBrandNavyBrush}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="StateFilter" Width="160" Height="34" SelectedIndex="0" SelectionChanged="StateFilter_Changed">
                            <ComboBoxItem Content="الكل"/>
                            <ComboBoxItem Content="بالانتظار"/>
                            <ComboBoxItem Content="قيد المعالجة"/>
                            <ComboBoxItem Content="مكتمل"/>
                            <ComboBoxItem Content="فشل"/>
                            <ComboBoxItem Content="مكرر (تخطٍ)"/>
                        </ComboBox>
                        <Button Content="⟳ تحديث التقرير" Background="{StaticResource WeraSurfaceBaseBrush}" BorderBrush="{StaticResource WeraBorderDefaultBrush}" BorderThickness="1" CornerRadius="10" Click="ReloadReport_Click"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" x:Name="FilesSummaryText" Text="لا صفوف بعد — أنشئ مهمة وأضف ملفات"
                               FontSize="12" Foreground="{StaticResource WeraTextSecondaryBrush}" Padding="14,0,14,6"/>

                    <ScrollViewer Grid.Row="2" Padding="14,0">
                        <ItemsControl x:Name="FilesControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ImportFileRow" xmlns:vm="using:WeraPro.Desktop.ViewModels">
                                    <Grid Padding="8,6" BorderBrush="{StaticResource WeraBorderRowBrush}" BorderThickness="0,0,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="2*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind Ordinal}" FontFamily="{StaticResource WeraFontMono}" FontSize="11"
                                                   Foreground="{StaticResource WeraTextMutedBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind NameAr}" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="{x:Bind SizeAr}" FontSize="11.5" VerticalAlignment="Center"
                                                   Foreground="{StaticResource WeraTextSecondaryBrush}"/>
                                        <TextBlock Grid.Column="3" Text="{x:Bind StateAr}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{x:Bind DetailAr}" FontSize="11.5" VerticalAlignment="Center"
                                                   Foreground="{StaticResource WeraTextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="12" Padding="14,10"
                                BorderBrush="{StaticResource WeraBorderDefaultBrush}" BorderThickness="0,1,0,0">
                        <Button Content="‹ السابق" Background="{StaticResource WeraSurfaceBaseBrush}" BorderBrush="{StaticResource WeraBorderDefaultBrush}" BorderThickness="1" CornerRadius="10" Click="PrevPage_Click"/>
                        <Button Content="التالي ›" Background="{StaticResource WeraSurfaceBaseBrush}" BorderBrush="{StaticResource WeraBorderDefaultBrush}" BorderThickness="1" CornerRadius="10" Click="NextPage_Click"/>
                        <TextBlock x:Name="FilesPageText" Text="—" FontSize="12" Foreground="{StaticResource WeraTextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ملاحظة الحقيقة -->
            <TextBlock Grid.Row="3" Padding="22,0,22,12" FontSize="11" TextWrapping="Wrap"
                       Foreground="{StaticResource WeraTextMutedBrush}"
                       Text="الحدود الخادمية: JPEG/PNG فقط · ≤ 10MB للملف · ≤ 24 مليون بكسل · المطابق تماماً (SHA-256) يتخطى ويشير للأصل القائم — لا تكرار أبداً"/>
        </Grid>

    </UserControl>
</Window>
