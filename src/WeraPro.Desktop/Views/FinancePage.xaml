<!-- Views/FinancePage.xaml — WERA PRO HD Desktop (G8)
     المالية (§14/§13): الخزائن والأدراج وحركات النقد (PAGE-35) + سندات
     القبض/الصرف/التحويل (PAGE-37) + المصروفات (PAGE-36) + رأس المال
     والأرصدة الافتتاحية (PAGE-38) + الورديات وإقفالها (PAGE-33/34). -->
<Page
    x:Class="WeraPro.Desktop.Views.FinancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" FlowDirection="RTL"
    xmlns:vm="using:WeraPro.Desktop.ViewModels">

    <Grid RowSpacing="10" Padding="18,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="10">
            <Button x:Name="NewVoucherButton" Content="سند جديد…" Style="{StaticResource AccentButtonStyle}" Click="NewVoucher_Click"/>
            <Button x:Name="NewExpenseButton" Content="مصروف جديد…" Click="NewExpense_Click"/>
            <Button x:Name="NewCapitalButton" Content="حدث رأس مال…" Click="NewCapital_Click"/>
            <Button x:Name="NewAccountButton" Content="حساب خزينة جديد…" Click="NewAccount_Click"/>
            <ProgressRing x:Name="LoadingRing" Width="22" Height="22" Visibility="Collapsed"/>
        </StackPanel>

        <TextBlock Grid.Row="1" x:Name="ErrorText" FontSize="13" Foreground="{StaticResource WeraStatusDangerBrush}" Visibility="Collapsed" TextWrapping="Wrap"/>

        <Pivot Grid.Row="2" SelectionChanged="Pivot_SelectionChanged">
            <!-- الخزائن والأدراج وحركات النقد (PAGE-35) -->
            <PivotItem Header="الخزائن والأدراج (PAGE-35)">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="480"/>
                    </Grid.ColumnDefinitions>
                    <ListView x:Name="AccountsList" ItemsSource="{x:Bind Vm.Accounts}" SelectionMode="Single"
                              SelectionChanged="AccountsList_SelectionChanged">
                        <ListView.HeaderTemplate>
                            <DataTemplate>
                                <Grid Padding="12,6" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/><ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/><ColumnDefinition Width="120"/><ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="الكود" Style="{StaticResource CaptionTextBlockStyle}"/>
                                    <TextBlock Grid.Column="1" Text="الاسم" Style="{StaticResource CaptionTextBlockStyle}"/>
                                    <TextBlock Grid.Column="2" Text="النوع" Style="{StaticResource CaptionTextBlockStyle}"/>
                                    <TextBlock Grid.Column="3" Text="النطاق" Style="{StaticResource CaptionTextBlockStyle}"/>
                                    <TextBlock Grid.Column="4" Text="الرصيد (دفتر)" Style="{StaticResource CaptionTextBlockStyle}"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.HeaderTemplate>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:TreasuryAccountRow">
                                <Grid Padding="12,8" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/><ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/><ColumnDefinition Width="120"/><ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Code}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind NameAr}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{x:Bind KindAr}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{x:Bind ScopeAr}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{x:Bind BalanceAr}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Grid Grid.Column="1" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="TxnHeader" Text="حركات الحساب المحدد — مستند وسبب لكل حركة (§14.2 ق4)" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap"/>
                        <ListView Grid.Row="1" x:Name="TxnList" ItemsSource="{x:Bind Vm.Transactions}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:TreasuryTxnRow">
                                    <Grid Padding="8,6" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64"/><ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind DirectionAr}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind AmountAr}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="2" Text="{x:Bind DocAr}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{x:Bind Reason}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="4" Text="{x:Bind TimeAr}" VerticalAlignment="Center" Opacity="0.75"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </PivotItem>

            <!-- سندات القبض والصرف والتحويل (PAGE-37) -->
            <PivotItem Header="السندات (PAGE-37)">
                <ListView x:Name="VouchersList" ItemsSource="{x:Bind Vm.Vouchers}">
                    <ListView.HeaderTemplate>
                        <DataTemplate>
                            <Grid Padding="12,6" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/><ColumnDefinition Width="64"/><ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="130"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="الرقم" Style="{StaticResource CaptionTextBlockStyle}"/>
                                <TextBlock Grid.Column="1" Text="النوع" Style="{StaticResource CaptionTextBlockStyle}"/>
                                <TextBlock Grid.Column="2" Text="المبلغ" Style="{StaticResource CaptionTextBlockStyle}"/>
                                <TextBlock Grid.Column="3" Text="الخزائن" Style="{StaticResource CaptionTextBlockStyle}"/>
                                <TextBlock Grid.Column="4" Text="السبب / الطرف" Style="{StaticResource CaptionTextBlockStyle}"/>
                                <TextBlock Grid.Column="5" Text="الحالة" Style="{StaticResource CaptionTextBlockStyle}"/>
                                <TextBlock Grid.Column="6" Text="التوزيع" Style="{StaticResource CaptionTextBlockStyle}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.HeaderTemplate>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:VoucherRow">
                            <Grid Padding="12,8" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/><ColumnDefinition Width="64"/><ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Number}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind TypeAr}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{x:Bind AmountAr}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="3" Text="{x:Bind Account}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="4" Orientation="Vertical" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Reason}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind CounterpartyAr}" FontSize="11" Opacity="0.75" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Grid.Column="5" Text="{x:Bind StatusAr}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind AllocationsAr}" VerticalAlignment="Center" FontSize="11"/>
                                    <Button Content="ترحيل" FontSize="12" Padding="8,3"
                                            Click="PostVoucher_Click" Tag="{x:Bind Id}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </PivotItem>

            <!-- المصروفات (PAGE-36) -->
            <PivotItem Header="المصروفات (PAGE-36)">
                <ListView x:Name="ExpensesList" ItemsSource="{x:Bind Vm.Expenses}">
                    <ListView.HeaderTemplate>
                        <DataTemplate>
                            <Grid Padding="12,6" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/><ColumnDefinition Width="120"/><ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="80"/><ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="الرقم" Style="{StaticResource CaptionTextBlockStyle}"/>
                                <TextBlock Grid.Column="1" Text="الفئة" Style="{StaticResource CaptionTextBlockStyle}"/>
                                <TextBlock Grid.Column="2" Text="المسدد" Style="{StaticResource CaptionTextBlockStyle}"/>
                                <TextBlock Grid.Column="3" Text="المستفيد / الوسيلة" Style="{StaticResource CaptionTextBlockStyle}"/>
                                <TextBlock Grid.Column="4" Text="الارتباط" Style="{StaticResource CaptionTextBlockStyle}"/>
                                <TextBlock Grid.Column="5" Text="الحالة" Style="{StaticResource CaptionTextBlockStyle}"/>
                                <TextBlock Grid.Column="6" Text="إجراءات" Style="{StaticResource CaptionTextBlockStyle}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.HeaderTemplate>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ExpenseRow">
                            <Grid Padding="12,8" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/><ColumnDefinition Width="120"/><ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="80"/><ColumnDefinition Width="170"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Number}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind Category}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{x:Bind OutflowAr}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <StackPanel Grid.Column="3" Orientation="Vertical" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Beneficiary}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind MethodAr}" FontSize="11" Opacity="0.75"/>
                                </StackPanel>
                                <TextBlock Grid.Column="4" Text="{x:Bind ShiftAr}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="5" Text="{x:Bind StatusAr}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Content="اعتماد" FontSize="12" Padding="8,3" Click="ApproveExpense_Click" Tag="{x:Bind Id}"/>
                                    <Button Content="ترحيل" FontSize="12" Padding="8,3" Click="PostExpense_Click" Tag="{x:Bind Id}"/>
                                    <Button Content="إلغاء" FontSize="12" Padding="8,3" Click="CancelExpense_Click" Tag="{x:Bind Id}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </PivotItem>

            <!-- رأس المال والأرصدة الافتتاحية (PAGE-38) -->
            <PivotItem Header="رأس المال (PAGE-38)">
                <StackPanel Spacing="8">
                    <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8"
                               Text="رأس المال بحدث موثق بكل مرة — لا يُساوى بالمبيعات أو الصندوق أو المخزون (§14.3). الرصيد الافتتاحي لا يُنشأ إلا باعتماد مسبق (D-14 — الأرصدة بمستندات معتمدة فقط)."/>
                    <ListView x:Name="CapitalList" ItemsSource="{x:Bind Vm.CapitalEvents}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:CapitalRow">
                                <Grid Padding="12,8" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/><ColumnDefinition Width="120"/><ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Number}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind TypeAr}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{x:Bind AmountAr}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="3" Text="{x:Bind Treasury}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{x:Bind Description}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="5" Text="{x:Bind StatusAr}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="6" Content="ترحيل" FontSize="12" Padding="8,3" Click="PostCapital_Click" Tag="{x:Bind Id}"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </PivotItem>

            <!-- الورديات وإقفالها (PAGE-33/34) -->
            <PivotItem Header="الورديات (PAGE-33/34)">
                <ListView x:Name="ShiftsList" ItemsSource="{x:Bind Vm.Shifts}">
                    <ListView.HeaderTemplate>
                        <DataTemplate>
                            <Grid Padding="12,6" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="90"/><ColumnDefinition Width="90"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="المحطة" Style="{StaticResource CaptionTextBlockStyle}"/>
                                <TextBlock Grid.Column="1" Text="الفتح" Style="{StaticResource CaptionTextBlockStyle}"/>
                                <TextBlock Grid.Column="2" Text="الافتتاحي" Style="{StaticResource CaptionTextBlockStyle}"/>
                                <TextBlock Grid.Column="3" Text="المتوقع" Style="{StaticResource CaptionTextBlockStyle}"/>
                                <TextBlock Grid.Column="4" Text="الفعلي" Style="{StaticResource CaptionTextBlockStyle}"/>
                                <TextBlock Grid.Column="5" Text="الحالة" Style="{StaticResource CaptionTextBlockStyle}"/>
                                <TextBlock Grid.Column="6" Text="الفارق" Style="{StaticResource CaptionTextBlockStyle}"/>
                                <TextBlock Grid.Column="7" Text="إجراءات" Style="{StaticResource CaptionTextBlockStyle}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.HeaderTemplate>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ShiftRow">
                            <Grid Padding="12,8" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="90"/><ColumnDefinition Width="90"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Station}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind OpenedAr}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{x:Bind FloatAr}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{x:Bind ExpectedAr}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="{x:Bind CountedAr}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="5" Text="{x:Bind StatusAr}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="6" Text="{x:Bind VarianceAr}" VerticalAlignment="Center"/>
                                <Button Grid.Column="7" Content="مطابقة/إقفال…" FontSize="12" Padding="8,3" Click="ReconcileShift_Click" Tag="{x:Bind Id}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
