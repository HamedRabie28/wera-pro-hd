<!-- Views/PurchasingHubPage.xaml — WERA PRO HD Desktop (G6)
     المشتريات: السلة وأوامر الشراء (PAGE-24) + الاستلامات (PAGE-25 — الحدث
     الذي يزيد المخزون لا الفاتورة) + الفواتير والسداد (PAGE-26 — التزام مالي
     وأثر خزينة واحد) + المرتجعات (PAGE-27 — مرتبطة بالاستلام الأصلي). -->
<Page
    x:Class="WeraPro.Desktop.Views.PurchasingHubPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d" FlowDirection="RightToLeft"
    xmlns:vm="using:WeraPro.Desktop.ViewModels">

    <Grid RowSpacing="10" Padding="18,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="10">
            <Button x:Name="NewBasketButton" Content="سلة مشتريات جديدة…" Style="{StaticResource AccentButtonStyle}" Click="NewBasket_Click"/>
            <Button x:Name="NewReceiptButton" Content="استلام جديد…" Click="NewReceipt_Click"/>
            <Button x:Name="NewInvoiceButton" Content="فاتورة مورد جديدة…" Click="NewInvoice_Click"/>
            <Button x:Name="NewPaymentButton" Content="سداد للمورد…" Click="NewPayment_Click"/>
            <Button x:Name="NewReturnButton" Content="مرتجع للمورد…" Click="NewReturn_Click"/>
            <ProgressRing x:Name="LoadingRing" Width="22" Height="22" Visibility="Collapsed"/>
        </StackPanel>

        <TextBlock Grid.Row="1" x:Name="ErrorText" FontSize="13" Foreground="{StaticResource WeraStatusDangerBrush}" Visibility="Collapsed" TextWrapping="Wrap"/>

        <Pivot Grid.Row="2">
            <!-- سلة المشتريات وأوامر الشراء (PAGE-24) -->
            <PivotItem Header="السلة وأوامر الشراء (PAGE-24)">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="440"/>
                    </Grid.ColumnDefinitions>
                    <ListView x:Name="OrdersList" ItemsSource="{x:Bind Vm.Orders}" SelectionMode="Single"
                              SelectionChanged="OrdersList_SelectionChanged">
                        <ListView.HeaderTemplate>
                            <DataTemplate>
                                <Grid Padding="10,6" Background="{StaticResource WeraSurfaceSubtleBrush}" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/><ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/><ColumnDefinition Width="120"/><ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="الرقم" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Grid.Column="1" Text="المورد" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Grid.Column="2" Text="الحالة" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Grid.Column="3" Text="الأسطر" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Grid.Column="4" Text="الإجمالي" FontWeight="SemiBold" FontSize="12"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.HeaderTemplate>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:PoRow">
                                <Grid Padding="10,7" ColumnSpacing="10" BorderBrush="{StaticResource WeraBorderRowBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/><ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/><ColumnDefinition Width="120"/><ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind PoNumber}" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Supplier}" FontSize="12"/>
                                    <TextBlock Grid.Column="2" Text="{x:Bind StatusAr}" FontSize="12"/>
                                    <TextBlock Grid.Column="3" Text="{x:Bind LinesAr}" FontSize="12"/>
                                    <TextBlock Grid.Column="4" Text="{x:Bind TotalAr}" FontSize="12"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Column="1" Spacing="8">
                        <TextBlock Text="أسطر المحدد (المسودة قابلة للاستعادة — لا مخزون ولا مال قبل الاستلام)" FontSize="12"
                                   Foreground="{StaticResource WeraTextSecondaryBrush}" TextWrapping="Wrap"/>
                        <ListView ItemsSource="{x:Bind Vm.SelectedOrderLines}" Height="220">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:PoLineRow">
                                    <Grid Padding="6,5" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Sku}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind QtyAr}" FontSize="12"/>
                                        <TextBlock Grid.Column="2" Text="{x:Bind TotalAr}" FontSize="12"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="إصدار الأمر" Click="SubmitOrder_Click"/>
                            <Button Content="إلغاء" Click="CancelOrder_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </PivotItem>

            <!-- الاستلامات (PAGE-25) -->
            <PivotItem Header="الاستلامات (PAGE-25)">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="440"/>
                    </Grid.ColumnDefinitions>
                    <ListView x:Name="ReceiptsList" ItemsSource="{x:Bind Vm.Receipts}" SelectionMode="Single"
                              SelectionChanged="ReceiptsList_SelectionChanged">
                        <ListView.HeaderTemplate>
                            <DataTemplate>
                                <Grid Padding="10,6" Background="{StaticResource WeraSurfaceSubtleBrush}" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/><ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/><ColumnDefinition Width="90"/><ColumnDefinition Width="180"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="الرقم" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Grid.Column="1" Text="المورد" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Grid.Column="2" Text="المخزن" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Grid.Column="3" Text="الأسطر" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Grid.Column="4" Text="الحالة" FontWeight="SemiBold" FontSize="12"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.HeaderTemplate>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ReceiptRow">
                                <Grid Padding="10,7" ColumnSpacing="10" BorderBrush="{StaticResource WeraBorderRowBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/><ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/><ColumnDefinition Width="90"/><ColumnDefinition Width="180"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Number}" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Supplier}" FontSize="12"/>
                                    <TextBlock Grid.Column="2" Text="{x:Bind Warehouse}" FontSize="12"/>
                                    <TextBlock Grid.Column="3" Text="{x:Bind LinesAr}" FontSize="12"/>
                                    <TextBlock Grid.Column="4" Text="{x:Bind StatusAr}" FontSize="12"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Column="1" Spacing="8">
                        <TextBlock Text="أسطر الاستلام بلقطة التحويل للوحدة الأساسية (الترحيل يزيد المخزون فوراً)" FontSize="12"
                                   Foreground="{StaticResource WeraTextSecondaryBrush}" TextWrapping="Wrap"/>
                        <ListView ItemsSource="{x:Bind Vm.SelectedReceiptLines}" Height="260">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ReceiptLineRow">
                                    <Grid Padding="6,5" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="80"/><ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Sku}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind QtyAr}" FontSize="12"/>
                                        <TextBlock Grid.Column="2" Text="{x:Bind BaseAr}" FontSize="12"/>
                                        <TextBlock Grid.Column="3" Text="{x:Bind LotAr}" FontSize="12"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Button x:Name="PostReceiptButton" Content="ترحيل الاستلام (زيادة المخزون)" Click="PostReceipt_Click"/>
                    </StackPanel>
                </Grid>
            </PivotItem>

            <!-- الفواتير والسداد (PAGE-26) -->
            <PivotItem Header="الفواتير والسداد (PAGE-26)">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/><RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="فواتير الموردين — التزام مالي لا حركة مخزون" FontSize="13" FontWeight="SemiBold"/>
                        <ListView Grid.Row="1" ItemsSource="{x:Bind Vm.Invoices}">
                            <ListView.HeaderTemplate>
                                <DataTemplate>
                                    <Grid Padding="10,6" Background="{StaticResource WeraSurfaceSubtleBrush}" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/><ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="110"/><ColumnDefinition Width="130"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="رقم المورد" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock Grid.Column="1" Text="المورد" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock Grid.Column="2" Text="الإجمالي" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock Grid.Column="3" Text="المسدد" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock Grid.Column="4" Text="المتبقي" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock Grid.Column="5" Text="الحالة" FontWeight="SemiBold" FontSize="12"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.HeaderTemplate>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:InvoiceRow">
                                    <Grid Padding="10,7" ColumnSpacing="10" BorderBrush="{StaticResource WeraBorderRowBrush}" BorderThickness="0,0,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/><ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="110"/><ColumnDefinition Width="130"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Number}" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Supplier}" FontSize="12"/>
                                        <TextBlock Grid.Column="2" Text="{x:Bind TotalAr}" FontSize="12"/>
                                        <TextBlock Grid.Column="3" Text="{x:Bind PaidAr}" FontSize="12"/>
                                        <TextBlock Grid.Column="4" Text="{x:Bind RemainingAr}" FontSize="12"/>
                                        <TextBlock Grid.Column="5" Text="{x:Bind StatusAr}" FontSize="12"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="سندات السداد — أثر خزينة واحد مهما توزع على الفواتير (لا يُسجل مصروفاً)" FontSize="13" FontWeight="SemiBold"/>
                        <ListView Grid.Row="1" ItemsSource="{x:Bind Vm.Payments}">
                            <ListView.HeaderTemplate>
                                <DataTemplate>
                                    <Grid Padding="10,6" Background="{StaticResource WeraSurfaceSubtleBrush}" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/><ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="110"/><ColumnDefinition Width="170"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="السند" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock Grid.Column="1" Text="المورد" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock Grid.Column="2" Text="المبلغ" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock Grid.Column="3" Text="الوسيلة" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock Grid.Column="4" Text="التاريخ" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock Grid.Column="5" Text="التوزيع" FontWeight="SemiBold" FontSize="12"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.HeaderTemplate>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:PaymentRow">
                                    <Grid Padding="10,7" ColumnSpacing="10" BorderBrush="{StaticResource WeraBorderRowBrush}" BorderThickness="0,0,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/><ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="110"/><ColumnDefinition Width="170"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Voucher}" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Supplier}" FontSize="12"/>
                                        <TextBlock Grid.Column="2" Text="{x:Bind AmountAr}" FontSize="12"/>
                                        <TextBlock Grid.Column="3" Text="{x:Bind MethodAr}" FontSize="12"/>
                                        <TextBlock Grid.Column="4" Text="{x:Bind DateAr}" FontSize="12"/>
                                        <TextBlock Grid.Column="5" Text="{x:Bind AllocationsAr}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </PivotItem>

            <!-- المرتجعات (PAGE-27) -->
            <PivotItem Header="مرتجعات الموردين (PAGE-27)">
                <ListView ItemsSource="{x:Bind Vm.Returns}">
                    <ListView.HeaderTemplate>
                        <DataTemplate>
                            <Grid Padding="10,6" Background="{StaticResource WeraSurfaceSubtleBrush}" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="140"/><ColumnDefinition Width="130"/><ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="الرقم" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Grid.Column="1" Text="المورد" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Grid.Column="2" Text="أصل الاستلام" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Grid.Column="3" Text="طريقة الرد" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Grid.Column="4" Text="الإجمالي" FontWeight="SemiBold" FontSize="12"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.HeaderTemplate>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ReturnRow">
                            <Grid Padding="10,7" ColumnSpacing="10" BorderBrush="{StaticResource WeraBorderRowBrush}" BorderThickness="0,0,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="140"/><ColumnDefinition Width="130"/><ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Number}" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind Supplier}" FontSize="12"/>
                                <TextBlock Grid.Column="2" Text="{x:Bind OriginAr}" FontSize="12"/>
                                <TextBlock Grid.Column="3" Text="{x:Bind RefundAr}" FontSize="12"/>
                                <TextBlock Grid.Column="4" Text="{x:Bind TotalAr}" FontSize="12"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
