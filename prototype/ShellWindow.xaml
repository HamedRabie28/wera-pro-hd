<?xml version="1.0" encoding="utf-8"?>
<!--
  ShellWindow.xaml — Shell الإداري: شريط علوي فقط · لا Sidebar (§7.3)
  المجموعات العشر كما في المواصفة + Ctrl+K + حالة اتصال حقيقية + مستخدم/دور.
-->
<Window
    x:Class="WeraPrototype.ShellWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:views="using:WeraPrototype.Views">

    <Grid Background="{StaticResource WeraSurfaceBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>   <!-- TopNav: WeraTopNavHeight -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ الشريط العلوي (brand.navy) ═══ -->
        <Grid Grid.Row="0" Background="{StaticResource WeraBrandNavyBrush}" Padding="18,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- الشعار -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource WeraActionPrimaryBrush}">
                    <TextBlock Text="W" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="WERA PRO HD" Foreground="{StaticResource WeraShellTextBrush}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- مجموعات القوائم العشر (تتجمع في «المزيد» عند الضيق — لا قص عناصر) -->
            <muxc:NavigationView Grid.Column="1" x:Name="NavTop" PaneDisplayMode="Top"
                                 IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False"
                                 OpenPaneLength="0" Margin="12,0"
                                 SelectionChanged="NavTop_SelectionChanged">
                <muxc:NavigationView.MenuItems>
                    <muxc:NavigationViewItem Content="التشغيل" Tag="home" IsSelected="True"/>
                    <muxc:NavigationViewItem Content="المبيعات" Tag="sales"/>
                    <muxc:NavigationViewItem Content="الكتالوج" Tag="catalog"/>
                    <muxc:NavigationViewItem Content="المخزون" Tag="inventory"/>
                    <muxc:NavigationViewItem Content="المشتريات" Tag="purchasing"/>
                </muxc:NavigationView.MenuItems>
                <muxc:NavigationView.FooterMenuItems>
                    <!-- عناصر «المزيد» تُبنى حسب عرض النافذة — المجموعات الباقية:
                         الأطراف · المالية · التقارير · الأجهزة · الإدارة والأمان -->
                </muxc:NavigationView.FooterMenuItems>
            </muxc:NavigationView>

            <!-- Ctrl+K بحث عام -->
            <Button Grid.Column="2" x:Name="CommandPaletteBtn" Click="CommandPalette_Click"
                    Background="#00000000" BorderBrush="{StaticResource WeraShellBorderBrush}" BorderThickness="1" CornerRadius="8"
                    Padding="12,7" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE721;" FontSize="13" Foreground="{StaticResource WeraShellTextMutedBrush}"/>
                    <TextBlock Text="بحث عام" FontSize="12" Foreground="{StaticResource WeraShellTextMutedBrush}"/>
                    <Border Background="{StaticResource WeraShellBorderBrush}" CornerRadius="4" Padding="5,1">
                        <TextBlock Text="Ctrl+K" FontSize="10.5" Foreground="{StaticResource WeraShellTextSecondaryBrush}"/>
                    </Border>
                </StackPanel>
            </Button>

            <!-- حالة اتصال حقيقية (لا تُعرض «متصل» زوراً — §10.6) -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="14,0">
                <Ellipse Width="8" Height="8" Fill="{StaticResource WeraActionPrimaryInkBrush}"/>
                <TextBlock Text="متصل · فرع مدينة نصر · محطة 3" FontSize="12" Foreground="{StaticResource WeraShellTextSecondaryBrush}"/>
            </StackPanel>

            <FontIcon Grid.Column="4" Glyph="&#xEA8F;" FontSize="15" Foreground="{StaticResource WeraShellTextSecondaryBrush}" VerticalAlignment="Center"/>

            <!-- المستخدم/الدور -->
            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                        Padding="12,0" BorderBrush="{StaticResource WeraShellBorderBrush}" BorderThickness="1,0,0,0">
                <Border Width="30" Height="30" CornerRadius="999" Background="{StaticResource WeraAccentGoldBrush}">
                    <TextBlock Text="مأ" Foreground="White" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel>
                    <TextBlock Text="محمد عبد الرحمن" FontSize="12" Foreground="{StaticResource WeraShellTextBrush}"/>
                    <TextBlock Text="مالك / مدير" FontSize="10" Foreground="{StaticResource WeraShellTextMutedBrush}"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ═══ المحتوى ═══ -->
        <Frame Grid.Row="1" x:Name="ContentFrame">
            <views:HomePage/>
        </Frame>
    </Grid>
</Window>
