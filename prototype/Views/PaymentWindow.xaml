<?xml version="1.0" encoding="utf-8"?>
<!-- PaymentWindow.xaml — نافذة الدفع: البطاقة معطلة بسببها الحقيقي (B-02/D-11) لا مختفية -->
<Window
    x:Class="WeraPrototype.Views.PaymentWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource WeraSurfaceBackgroundBrush}" MinWidth="880" MinHeight="640">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource WeraBrandNavyDeepBrush}" Padding="22,14">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="💳 الدفع — الفاتورة INV-112042" FontFamily="{StaticResource WeraFontDisplay}" FontSize="17" FontWeight="Bold" Foreground="White"/>
            </StackPanel>
            <Button Content="✕ رجوع للسلة (Esc)" Background="Transparent" Foreground="{StaticResource WeraShellTextSecondaryBrush}" BorderBrush="{StaticResource WeraShellBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,6" HorizontalAlignment="Left"/>
        </Grid>

        <!-- المستحق -->
        <Grid Grid.Row="1" Background="{StaticResource WeraAccentGoldSoftBrush}" Padding="24,14"
              BorderBrush="{StaticResource WeraAccentGoldBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="المستحق الإجمالي (شامل الضريبة 14% — D-01)" FontSize="12.5" Foreground="{StaticResource WeraAccentGoldInkBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Text="219.60 ج.م" FontFamily="{StaticResource WeraFontDisplay}" FontSize="36" FontWeight="Bold" Foreground="{StaticResource WeraBrandNavyBrush}"/>
            </StackPanel>
            <TextBlock Text="4 أسطر · عميل نقدي · الضريبة المضمّنة 26.99 ج.م تُفصل عند الترحيل"
                       FontSize="12" Foreground="{StaticResource WeraTextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <!-- الوسائل -->
            <StackPanel Grid.Column="0" Padding="24,20" BorderBrush="{StaticResource WeraBorderDefaultBrush}" BorderThickness="0,0,1,0" Spacing="16">
                <TextBlock Text="وسيلة الدفع" FontFamily="{StaticResource WeraFontDisplay}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource WeraBrandNavyBrush}"/>
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource WeraActionPrimarySoftBrush}" BorderBrush="{StaticResource WeraActionPrimaryBrush}" BorderThickness="1.5" CornerRadius="12" Padding="14">
                        <StackPanel HorizontalAlignment="Center"><TextBlock Text="💵" FontSize="22" HorizontalAlignment="Center"/>
                            <TextBlock Text="نقد" FontFamily="{StaticResource WeraFontDisplay}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource WeraActionPrimaryInkBrush}" HorizontalAlignment="Center"/></StackPanel>
                    </Border>
                    <!-- البطاقة: معطلة بسبب معلن (B-02/D-11) — لا تختفي ولا تدّعي الاتصال -->
                    <Border Grid.Row="0" Grid.Column="1" BorderBrush="{StaticResource WeraBorderDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Opacity="0.55">
                        <StackPanel HorizontalAlignment="Center"><TextBlock Text="💳" FontSize="22" HorizontalAlignment="Center"/>
                            <TextBlock Text="بطاقة" FontFamily="{StaticResource WeraFontDisplay}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource WeraTextSecondaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="معطلة — بانتظار اعتماد مزود (D-11)" FontSize="10" Foreground="{StaticResource WeraStatusDangerBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/></StackPanel>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="0" BorderBrush="{StaticResource WeraBorderDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                        <StackPanel HorizontalAlignment="Center"><TextBlock Text="🔀" FontSize="22" HorizontalAlignment="Center"/>
                            <TextBlock Text="مختلط (Split)" FontFamily="{StaticResource WeraFontDisplay}" FontSize="13.5" Foreground="{StaticResource WeraTextSecondaryBrush}" HorizontalAlignment="Center"/></StackPanel>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" BorderBrush="{StaticResource WeraBorderDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                        <StackPanel HorizontalAlignment="Center"><TextBlock Text="📝" FontSize="22" HorizontalAlignment="Center"/>
                            <TextBlock Text="آجل" FontFamily="{StaticResource WeraFontDisplay}" FontSize="13.5" Foreground="{StaticResource WeraTextSecondaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="يتطلب عميلاً بحد ائتمان (D-05)" FontSize="10" Foreground="{StaticResource WeraTextMutedBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/></StackPanel>
                    </Border>
                </Grid>

                <TextBlock Text="المبلغ المستلم نقداً" FontSize="12.5" Foreground="{StaticResource WeraTextSecondaryBrush}"/>
                <TextBox Text="250.00" FontFamily="{StaticResource WeraFontDisplay}" FontSize="26" FontWeight="Bold" Height="54" CornerRadius="10"/>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="50" Style="{StaticResource KeypadStyle}" Height="48"/><Button Grid.Column="1" Content="100" Style="{StaticResource KeypadStyle}" Height="48"/><Button Grid.Column="2" Content="200" Style="{StaticResource KeypadStyle}" Height="48"/>
                </Grid>
            </StackPanel>

            <!-- التأكيد -->
            <StackPanel Grid.Column="1" Padding="24,20" Background="{StaticResource WeraSurfaceSubtleBrush}" Spacing="16">
                <Border Background="{StaticResource WeraSurfaceBaseBrush}" BorderBrush="{StaticResource WeraBorderDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                    <StackPanel Spacing="8">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="المستحق" FontSize="12.5" Foreground="{StaticResource WeraTextSecondaryBrush}"/><TextBlock Grid.Column="1" Text="219.60 ج.م" FontSize="12.5" FontWeight="SemiBold"/></Grid>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="المدفوع (نقد)" FontSize="12.5" Foreground="{StaticResource WeraTextSecondaryBrush}"/><TextBlock Grid.Column="1" Text="250.00 ج.م" FontSize="12.5" FontWeight="SemiBold"/></Grid>
                        <Grid BorderBrush="{StaticResource WeraBrandNavyBrush}" BorderThickness="0,2,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                                <TextBlock Text="الباقي للعميل" FontFamily="{StaticResource WeraFontDisplay}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource WeraBrandNavyBrush}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="30.40 ج.م" FontFamily="{StaticResource WeraFontDisplay}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource WeraStatusSuccessBrush}" Margin="0,8,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Button Content="✓ تأكيد الدفع وترحيل الفاتورة" Style="{StaticResource PosTouchButtonStyle}"
                        Background="{StaticResource WeraActionPrimaryBrush}" Foreground="White" BorderThickness="0"
                        HorizontalAlignment="Stretch" FontSize="16.5" Click="Confirm_Click"/>
                <TextBlock Text="منع التكرار: Idempotency Key لكل عملية — لا ازدواج بيع أو خصم مخزون (§15.4)"
                           FontSize="11" Foreground="{StaticResource WeraTextMutedBrush}" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                <Border Background="{StaticResource WeraSurfaceBaseBrush}" BorderBrush="{StaticResource WeraBorderDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="12">
                    <TextBlock Text="💡 البطاقة تظهر معطلة بسببها الحقيقي (المانع B-02 — بانتظار مزود/Sandbox) — لا تختفي ولا تدّعي الاتصال. البيع الجاري نقد/مختلط نقد فقط."
                               FontSize="11.5" Foreground="{StaticResource WeraTextSecondaryBrush}" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
