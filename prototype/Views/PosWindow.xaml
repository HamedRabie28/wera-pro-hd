<?xml version="1.0" encoding="utf-8"?>
<!-- PosWindow.xaml — POS نافذة مستقلة بلا أي قائمة إدارية (§9 / LF-P) · DEV DATA
     الحد الأدنى 1280×720: QuickPick يخفى دون 1280px — لوحة المجاميع 300px عند 1366. -->
<Window
    x:Class="WeraPrototype.Views.PosWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource WeraSurfaceBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>   <!-- شريط الجلسة -->
            <RowDefinition Height="Auto"/> <!-- الالتقاط -->
            <RowDefinition Height="*"/>    <!-- السلة + المجاميع -->
            <RowDefinition Height="40"/>   <!-- F-keys -->
        </Grid.RowDefinitions>

        <!-- شريط الجلسة -->
        <Grid Grid.Row="0" Background="{StaticResource WeraBrandNavyDeepBrush}" Padding="14,0">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" HorizontalAlignment="Right">
                <Border Background="{StaticResource WeraActionPrimaryBrush}" CornerRadius="6" Padding="8,2">
                    <TextBlock Text="POS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource WeraShellTealGlowBrush}"/>
                </Border>
                <TextBlock Text="الوردية #47 · محطة 3 · منال أحمد (كاشير)" FontSize="12.5" Foreground="{StaticResource WeraShellTextSecondaryBrush}"/>
                <StackPanel Orientation="Horizontal" Spacing="6" BorderBrush="{StaticResource WeraShellBorderBrush}" BorderThickness="1,0,0,0" Padding="12,0">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource WeraActionPrimaryInkBrush}"/>
                    <TextBlock Text="متصل" FontSize="12" Foreground="{StaticResource WeraShellTealGlowBrush}"/>
                </StackPanel>
                <TextBlock Text="12:41" FontSize="12.5" Foreground="{StaticResource WeraShellTextMutedBrush}"/>
            </StackPanel>
        </Grid>

        <!-- منطقة الالتقاط: باركود دائم التركيز + أزرار F -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Padding="14,10"
                    Background="{StaticResource WeraSurfaceBaseBrush}"
                    BorderBrush="{StaticResource WeraBorderDefaultBrush}" BorderThickness="0,0,0,1">
            <TextBox x:Name="BarcodeField" PlaceholderText="امسح الباركود أو اكتب للبحث…"
                     FontFamily="{StaticResource WeraFontMono}" FlowDirection="LeftToRight"
                     Height="48" CornerRadius="10" HorizontalAlignment="Stretch"/>
            <Button Content="⚖️ وزن  F2" Style="{StaticResource PosTouchButtonStyle}" Click="OpenWeight_Click"/>
            <Button Content="↩ مرتجع  F12" Style="{StaticResource PosTouchButtonStyle}"/>
            <Button Content="⏸ تعليق  F8" Style="{StaticResource PosTouchButtonStyle}"/>
        </StackPanel>

        <!-- السلة + المجاميع -->
        <Grid Grid.Row="2" Padding="14,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- جدول السلة المركزي -->
            <Border Grid.Column="0" Background="{StaticResource WeraSurfaceBaseBrush}"
                    BorderBrush="{StaticResource WeraBorderDefaultBrush}" BorderThickness="1" CornerRadius="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Padding="14,9" BorderBrush="{StaticResource WeraBorderDefaultBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Text="سلة الفاتورة INV-112042" FontFamily="{StaticResource WeraFontDisplay}" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource WeraBrandNavyBrush}"/>
                        <TextBlock Text="4 أسطر" FontSize="12" Foreground="{StaticResource WeraTextMutedBrush}" VerticalAlignment="Center"/>
                        <Border Background="{StaticResource WeraStatusInfoSoftBrush}" CornerRadius="999" Padding="10,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="عميل: نقدي (بدون حساب)" FontSize="11" Foreground="{StaticResource WeraStatusInfoBrush}"/>
                        </Border>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1">
                        <ItemsControl ItemsSource="{x:Bind Cart}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:CartLine" xmlns:local="using:WeraPrototype.ViewModels">
                                    <Grid Padding="14,8" BorderBrush="{StaticResource WeraBorderRowBrush}" BorderThickness="0,0,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="95"/><ColumnDefinition Width="80"/><ColumnDefinition Width="95"/>
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xE74D;" FontSize="12" Foreground="{StaticResource WeraTextMutedBrush}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Text="{x:Bind Sku}" FontFamily="{StaticResource WeraFontMono}" FontSize="10.5" Foreground="{StaticResource WeraTextMutedBrush}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{x:Bind QtyOrWeight}" Style="{StaticResource MoneyCellStyle}"/>
                                        <TextBlock Grid.Column="3" Text="{x:Bind UnitPrice}" Style="{StaticResource MoneyCellStyle}"/>
                                        <TextBlock Grid.Column="4" Text="{x:Bind Discount}" FontSize="12.5" VerticalAlignment="Center" Foreground="{StaticResource WeraStatusDangerBrush}"/>
                                        <TextBlock Grid.Column="5" Text="{x:Bind Total}" Style="{StaticResource MoneyCellStyle}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- لوحة المجاميع: الإجراء الأساسي واحد (Teal) والقيمة المالية بشارة ذهبية -->
            <StackPanel Grid.Column="1" Spacing="10">
                <Border Background="{StaticResource WeraSurfaceBaseBrush}" BorderBrush="{StaticResource WeraBorderDefaultBrush}" BorderThickness="1" CornerRadius="14" Padding="16">
                    <StackPanel Spacing="7">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="المجموع الفرعي" FontSize="12.5" Foreground="{StaticResource WeraTextSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="222.30 ج.م" FontSize="12.5" FontWeight="SemiBold"/>
                        </Grid>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="الخصومات" FontSize="12.5" Foreground="{StaticResource WeraTextSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="-2.70 ج.م" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource WeraStatusDangerBrush}"/>
                        </Grid>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="الضريبة المضمّنة 14% — تُفصل عند الترحيل (D-01)" FontSize="11" Foreground="{StaticResource WeraTextMutedBrush}" TextWrapping="Wrap"/>
                            <TextBlock Grid.Column="1" Text="26.99 ج.م" FontSize="11" Foreground="{StaticResource WeraTextMutedBrush}"/>
                        </Grid>
                        <StackPanel Spacing="8" BorderBrush="{StaticResource WeraBrandNavyBrush}" BorderThickness="0,2,0,0" Padding="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="3" Height="34" CornerRadius="2" Background="{StaticResource WeraAccentGoldBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="المستحق" FontFamily="{StaticResource WeraFontDisplay}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource WeraBrandNavyBrush}" Padding="12,0,0,0"/>
                            </Grid>
                            <TextBlock Text="219.60 ج.م" Style="{StaticResource PosMoneyStyle}" Padding="12,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Button Content="💳 الدفع وترحيل الفاتورة  F4" Style="{StaticResource PosTouchButtonStyle}"
                        Background="{StaticResource WeraActionPrimaryBrush}" Foreground="White"
                        BorderThickness="0" HorizontalAlignment="Stretch" Click="OpenPayment_Click"/>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="👤 عميل F3"/><Button Grid.Column="1" Content="✂ خصم سطر"/>
                    <Button Grid.Column="0" Grid.Row="1" Content="⏸ تعليق السلة" Margin="0,8,0,0"/>
                    <Button Grid.Column="1" Grid.Row="1" Content="🗑 تفريغ" Margin="0,8,0,0"
                            Foreground="{StaticResource WeraStatusDangerBrush}"/>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                </Grid>

                <Border Background="{StaticResource WeraSurfaceSubtleBrush}" CornerRadius="10" Padding="12,10">
                    <TextBlock Text="الإيصال يطبع تلقائياً على طابعة المحطة المعتمدة (80mm) — بلا Print Dialog · نسخة الإدارة إلكترونية (D-16)"
                               FontSize="11" Foreground="{StaticResource WeraTextSecondaryBrush}" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </Grid>

        <!-- شريط الوظائف الثابت F1..F12 -->
        <Border Grid.Row="3" Background="{StaticResource WeraBrandNavyBrush}" Padding="16,0">
            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <TextBlock Text="F1 بحث · F2 وزن · F3 عميل · F4 دفع · F8 تعليق · F12 مرتجع" FontSize="12" Foreground="{StaticResource WeraShellTextSecondaryBrush}"/>
                <TextBlock Text="آخر فاتورة: INV-112041 · منذ دقيقتين (DEV)" FontSize="11.5" Foreground="{StaticResource WeraShellTextMutedBrush}" HorizontalAlignment="Left"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
